---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
import { leadership } from '../data/leadership';

const founders = [leadership[0], leadership[1]]; // Mr. Highness HC and Mr. Justice Friday
const executiveTeam = leadership.slice(2); // Mrs. Kiowa George, Divine Amadi, Kingston Onweagba
---

<BaseLayout
  title="Team | Leadership of Nicle Inc & All Things Web Technology"
  description="Meet Nicle Inc leadership: Mr. Highness HC, Mr. Justice Friday, Mrs. Kiowa Assing George, Divine Amadi, and Kingston Uchenna Onweagba — the team building the Nicer Ecosystem."
  activeNav="team"
  image="/og-default.png"
  canonical="/team"
  keywords="Nicle Inc team, Highness HC, Justice Friday, Kiowa George, Divine Amadi, Kingston Onweagba, Nicle leadership, founders"
>
  <Header active="team" />
  <main>
    <PageHero
      label="Team"
      title='The people Behind <span class="accent">Nicle</span>'
      subtitle="Leadership across operations, finance, project delivery, and vision — growing a privacy first, AI powered ecosystem worldwide."
      primaryCta={{ label: 'About Nicle', href: '/about' }}
      secondaryCta={{ label: 'View products', href: '/products' }}
    />

    <section class="teamPageSection">
      <!-- Founders Section (2 cards in 1 line) -->
      <div class="foundersHeader">
        <span class="sectionLabel">Founding Leadership</span>
        <h2 class="sectionTitle">The visionaries behind Nicle</h2>
        <p class="sectionLead">
          Founded by Mr. Highness HC and Mr. Justice Friday to pioneer proprietary AI models, encrypted communications, and the global Nicer Ecosystem.
        </p>
      </div>

      <div class="foundersTwoColGrid">
        {founders.map((founder) => (
          <article class="founderCard">
            <div class="founderCardHeader">
              <a href={`/team/${founder.slug}`} class="founderAvatarLink" aria-label={`View ${founder.name}'s Profile`}>
                <div
                  class:list={['founderAvatar', { founderAvatarPhoto: !!founder.photo }]}
                  style={!founder.photo ? `background: ${founder.gradient}` : undefined}
                >
                  {founder.photo ? (
                    <img src={founder.photo} alt={founder.name} class="founderPhoto" width="220" height="220" loading="eager" />
                  ) : (
                    <span>{founder.initials}</span>
                  )}
                </div>
                <div class="founderAvatarRing" aria-hidden="true"></div>
              </a>

              <div class="founderMeta">
                <span class="founderBadge">
                  {founder.slug === 'highness-hc' ? 'Founder & CEO' : 'Co-Founder & Manager'}
                </span>
                <h3 class="founderName">
                  <a href={`/team/${founder.slug}`} class="founderTitleLink">{founder.name}</a>
                </h3>
                <p class="founderRole">{founder.role.split('·')[0]}</p>
                <div class="founderTags">
                  {founder.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
                </div>
              </div>
            </div>

            <div class="founderBio">
              <p>{founder.shortBio || founder.bio[0]}</p>
            </div>

            <div class="founderCardFooter">
              <a href={`/team/${founder.slug}`} class="btnFounderCta">
                <span>Explore Full Profile</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Executive Leadership Team Section (3 cards) -->
      <div class="executivesHeader">
        <span class="sectionLabel">Executive Team</span>
        <h2 class="sectionTitle">Leadership driving execution &amp; growth</h2>
        <p class="sectionLead">
          Operations, financial strategy, agile technical delivery, and brand positioning across all platforms.
        </p>
      </div>

      <div class="executivesGrid">
        {executiveTeam.map((person) => (
          <article class="execCard">
            <a href={`/team/${person.slug}`} class="execAvatarLink" aria-label={`View ${person.name}'s Profile`}>
              <div
                class:list={['execAvatar', { execAvatarPhoto: !!person.photo }]}
                style={!person.photo ? `background: ${person.gradient}` : undefined}
              >
                {person.photo ? (
                  <img src={person.photo} alt={person.name} class="execPhoto" width="200" height="200" loading="lazy" />
                ) : (
                  <span>{person.initials}</span>
                )}
              </div>
            </a>

            <div class="execCardContent">
              <h3 class="execName">
                <a href={`/team/${person.slug}`} class="execTitleLink">{person.name}</a>
              </h3>
              <p class="execRole">{person.role.split('·')[0]}</p>

              <div class="execBio">
                <p>{person.shortBio || person.bio[0]}</p>
              </div>

              <div class="execTags">
                {person.tags.map((tag) => <span>{tag}</span>)}
              </div>

              <div class="execCardFooter">
                <a href={`/team/${person.slug}`} class="btnExecCta">
                  <span>View Full Profile</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .teamPageSection {
    padding: 2.5rem 2rem 6rem;
    background: var(--colorWhite);
    max-width: 1280px;
    margin: 0 auto;
  }

  /* Section Headers */
  .foundersHeader, .executivesHeader {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3rem;
  }

  .executivesHeader {
    margin-top: 5rem;
  }

  .sectionLabel {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--colorBrand);
    margin-bottom: 0.5rem;
  }

  .sectionTitle {
    font-family: var(--fontDisplay);
    font-size: clamp(1.75rem, 3.5vw, 2.35rem);
    font-weight: 700;
    color: var(--colorInk);
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .sectionLead {
    font-size: 1.025rem;
    color: var(--colorTextMuted);
    line-height: 1.65;
  }

  /* 2 Founders in 1 Line */
  .foundersTwoColGrid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .founderCard {
    background: linear-gradient(180deg, var(--colorSurfaceElevated), #ffffff);
    border: 1px solid var(--colorBorder);
    border-radius: var(--radiusLg);
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadowSoft);
    transition: transform 0.3s var(--easeOutExpo), box-shadow 0.3s var(--easeOutExpo);
  }

  .founderCard:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadowLift);
  }

  .founderCardHeader {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .founderAvatarLink {
    position: relative;
    text-decoration: none;
    flex-shrink: 0;
  }

  .founderAvatar {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 800;
    color: var(--colorWhite);
    font-family: var(--fontDisplay);
    border: 3px solid #ffffff;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.1);
    transition: transform 0.25s ease;
  }

  .founderAvatarLink:hover .founderAvatar {
    transform: scale(1.05);
  }

  .founderPhoto {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .founderAvatarRing {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid rgba(237, 53, 66, 0.35);
    pointer-events: none;
  }

  .founderMeta {
    flex: 1;
    min-width: 0;
  }

  .founderBadge {
    display: inline-block;
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--colorBrand);
    background: var(--colorBrandSoft);
    padding: 0.25rem 0.65rem;
    border-radius: 100px;
    margin-bottom: 0.4rem;
  }

  .founderName {
    font-family: var(--fontDisplay);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--colorInk);
    margin-bottom: 0.2rem;
    letter-spacing: -0.01em;
  }

  .founderTitleLink {
    text-decoration: none;
    color: var(--colorInk);
    transition: color 0.2s ease;
  }

  .founderTitleLink:hover {
    color: var(--colorBrand);
  }

  .founderRole {
    font-size: 0.875rem;
    color: var(--colorTextMuted);
    font-weight: 600;
    margin-bottom: 0.6rem;
    line-height: 1.35;
  }

  .founderTags, .execTags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .founderTags span, .execTags span {
    font-size: 0.725rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    background: var(--colorSurface);
    border: 1px solid var(--colorBorder);
    border-radius: 100px;
    color: var(--colorText);
  }

  .founderBio {
    font-size: 0.95rem;
    color: var(--colorText);
    line-height: 1.65;
    margin-bottom: 1.75rem;
    flex: 1;
  }

  .founderCardFooter {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--colorBorder);
  }

  .btnFounderCta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.75rem 1.25rem;
    background: var(--colorBrand);
    color: #ffffff;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(237, 53, 66, 0.2);
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btnFounderCta:hover {
    background: var(--colorBrandHover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(237, 53, 66, 0.3);
  }

  /* 3 Column Executive Grid */
  .executivesGrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .execCard {
    background: var(--colorSurfaceElevated);
    border: 1px solid var(--colorBorder);
    border-radius: var(--radiusMd);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .execCard:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadowSoft);
  }

  .execAvatarLink {
    display: inline-block;
    text-decoration: none;
    align-self: flex-start;
    margin-bottom: 1.25rem;
  }

  .execAvatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--colorWhite);
    font-family: var(--fontDisplay);
    border: 3px solid #ffffff;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
    transition: transform 0.25s ease;
  }

  .execAvatarLink:hover .execAvatar {
    transform: scale(1.05);
  }

  .execPhoto {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .execCardContent {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .execName {
    font-family: var(--fontDisplay);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--colorInk);
    margin-bottom: 0.25rem;
  }

  .execTitleLink {
    text-decoration: none;
    color: var(--colorInk);
    transition: color 0.2s ease;
  }

  .execTitleLink:hover {
    color: var(--colorBrand);
  }

  .execRole {
    font-size: 0.8125rem;
    color: var(--colorBrand);
    font-weight: 600;
    margin-bottom: 0.85rem;
    line-height: 1.4;
  }

  .execBio {
    font-size: 0.875rem;
    color: var(--colorText);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .execTags {
    margin-bottom: 1.5rem;
  }

  .execCardFooter {
    margin-top: auto;
    padding-top: 1.15rem;
    border-top: 1px solid var(--colorBorder);
  }

  .btnExecCta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.6rem 0.95rem;
    background: #ffffff;
    border: 1px solid var(--colorBorder);
    border-radius: 8px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--colorInk);
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .btnExecCta:hover {
    background: var(--colorBrandSoft);
    border-color: rgba(237, 53, 66, 0.3);
    color: var(--colorBrand);
  }

  @media (max-width: 1024px) {
    .foundersTwoColGrid {
      grid-template-columns: 1fr;
    }

    .executivesGrid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
  }

  @media (max-width: 640px) {
    .teamPageSection {
      padding: 1.5rem 1rem 4rem;
    }

    .founderCard {
      padding: 1.5rem;
    }

    .founderCardHeader {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }

    .founderTags {
      justify-content: center;
    }

    .execCard {
      text-align: center;
    }

    .execAvatarLink {
      align-self: center;
    }

    .execTags {
      justify-content: center;
    }
  }
</style>
