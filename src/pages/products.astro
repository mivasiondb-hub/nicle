---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
import NicerAiPlusShowcase from '../components/NicerAiPlusShowcase.astro';
import { products } from '../data/site';
import { productItemListSchema, productSeo } from '../data/productSeo';
import mivasionImage from '../assets/images/mivasion-fit.jpeg';
import worldnicerImage from '../assets/images/worldnicer-fit.jpeg';
import nicerappImage from '../assets/images/nicerapp-fit.jpeg';
import chatnicerImage from '../assets/images/chatnicer-fit.webp';
import nicerAiPlusImage from '../assets/images/nicer-ai-plus-fit.jpeg';

const productImages: Record<string, ImageMetadata> = {
  mivasion: mivasionImage,
  worldnicer: worldnicerImage,
  nicerapp: nicerappImage,
  chatnicer: chatnicerImage,
  niceraiplus: nicerAiPlusImage,
};

const productPaths: Record<string, string> = Object.fromEntries(
  productSeo.map((p) => [p.id, p.path])
);

const floatProducts = products.filter((p) => productImages[p.id]);
const standardProducts = products.filter((p) => p.id !== 'niceraiplus');
const beforeAi = standardProducts.slice(0, 3);
const afterAi = standardProducts.slice(3);
---

<BaseLayout
  title="Products | worldnicer, nicerapp, Mivasion, nicer ai plus & Chatnicer"
  description="Explore Nicle products and services: worldnicer privacy first social network, nicerapp encrypted messaging, Mivasion AI studio, nicer ai plus assistant, and Chatnicer photos & Reels."
  activeNav="products"
  image="/og-default.png"
  canonical="/products"
  keywords="Nicle products, worldnicer, nicerapp, Mivasion, nicer ai plus, Chatnicer, AI apps, social platforms, Nicle services"
  jsonLd={productItemListSchema}
>
  <Header active="products" />
  <main>
    <PageHero
      label="Products"
      title='Innovative <span class="accent">Products</span>'
      subtitle="Discover our ecosystem of tools designed for creativity and connection."
      rotatingTitles={[
        'Innovative <span class="accent">Products</span>',
        'Creative <span class="accent">AI Studios</span>',
        'Privacy-First <span class="accent">Platforms</span>',
        'Intelligent <span class="accent">Software</span>',
        'Next-Gen <span class="accent">Ecosystem</span>',
      ]}
      rotatingSubtitles={[
        'Discover our ecosystem of tools designed for creativity and connection.',
        'Groundbreaking platforms engineered for privacy, intelligence, and community.',
        'Empowering creators and businesses with next-generation artificial intelligence.',
        'From generative video studios to encrypted messaging and conversational AI assistants.',
      ]}
      primaryCta={{ label: 'Talk to our AI', href: '/products#niceraiplus' }}
      secondaryCta={{ label: 'Our story', href: '/about' }}
    />

    <!-- Quick Navigation Dock / Rounded Product Frame -->
    <section class="floatStrip" aria-label="Quick product navigation">
      <div class="dockContainer" data-scroll-reveal>
        <span class="dockLabel">Explore Ecosystem</span>
        <div class="dockRow">
          {floatProducts.map((product, i) => (
            <a
              href={productPaths[product.id] || `#${product.id}`}
              class="dockItem"
              style={`--itemAccent: ${product.accent}; --itemDelay: ${i * 0.06}s`}
              title={`Jump to ${product.name}`}
            >
              <div class="dockBubble">
                <Image
                  src={productImages[product.id]}
                  alt={product.name}
                  class="dockLogo"
                  widths={[96, 128, 160]}
                  sizes="54px"
                  formats={['avif', 'webp']}
                  quality={80}
                  loading="eager"
                  decoding="async"
                />
              </div>
              <span class="dockName">{product.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Main Products Showcase Section -->
    <section class="productsSection">
      <div class="productsList">
        {beforeAi.map((product, index) => (
          <article
            class:list={['productBlock', { reverse: index % 2 === 1 }]}
            id={product.id}
            data-scroll-reveal
            style={`--revealDelay: ${index * 0.05}s`}
          >
            <div class="productMediaCol">
              <a href={productPaths[product.id] || `#${product.id}`} class="productFloat" aria-label={product.name}>
                <Image
                  src={productImages[product.id]}
                  alt={`${product.name} logo`}
                  class="productLogo"
                  widths={[180, 240, 320]}
                  sizes="140px"
                  formats={['avif', 'webp']}
                  quality={80}
                  loading="lazy"
                  decoding="async"
                />
                <div class="productFloatGlow" style={`background: ${product.accent}`} aria-hidden="true"></div>
              </a>
            </div>

            <div class="productCopy">
              <span class="productAccent" style={`color: ${product.accent}`}>{product.tagline}</span>
              <h2 class="productTitle">{product.name}</h2>
              <p class="productDesc">{product.description}</p>

              <ul class="featureList">
                {product.features.map((feature) => (
                  <li>
                    <span class="check" style={`background: ${product.accent}`}></span>
                    {feature}
                  </li>
                ))}
              </ul>

              <div class="productLinks">
                <a href={productPaths[product.id] || `#${product.id}`} class="btnPrimary">
                  <span>Learn more</span>
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
                <a href="/about" class="btnGhost">Why Nicle builds this</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- AI Feature Showcase Section -->
    <NicerAiPlusShowcase />

    <!-- Products After AI Showcase -->
    <section class="productsSection productsSectionAfter">
      <div class="productsList">
        {afterAi.map((product, index) => (
          <article
            class:list={['productBlock', { reverse: (index + beforeAi.length) % 2 === 1 }]}
            id={product.id}
            data-scroll-reveal
            style={`--revealDelay: ${index * 0.05}s`}
          >
            <div class="productMediaCol">
              <a href={productPaths[product.id] || `#${product.id}`} class="productFloat" aria-label={product.name}>
                <Image
                  src={productImages[product.id]}
                  alt={`${product.name} logo`}
                  class="productLogo"
                  widths={[180, 240, 320]}
                  sizes="140px"
                  formats={['avif', 'webp']}
                  quality={80}
                  loading="lazy"
                  decoding="async"
                />
                <div class="productFloatGlow" style={`background: ${product.accent}`} aria-hidden="true"></div>
              </a>
            </div>

            <div class="productCopy">
              <span class="productAccent" style={`color: ${product.accent}`}>{product.tagline}</span>
              <h2 class="productTitle">{product.name}</h2>
              <p class="productDesc">{product.description}</p>

              <ul class="featureList">
                {product.features.map((feature) => (
                  <li>
                    <span class="check" style={`background: ${product.accent}`}></span>
                    {feature}
                  </li>
                ))}
              </ul>

              <div class="productLinks">
                <a href={productPaths[product.id] || `#${product.id}`} class="btnPrimary">
                  <span>Learn more</span>
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
                <a href="/about" class="btnGhost">Why Nicle builds this</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Unified Stack Section -->
    <section class="stackSection" data-scroll-reveal>
      <div class="stackInner">
        <span class="sectionLabel">Connected Ecosystem</span>
        <h2 class="sectionTitle">One company. One integrated stack.</h2>
        <p class="sectionLead">
          Social, messaging, creative AI, and intelligent assistance — designed to work as a
          coherent digital ecosystem under Nicle Inc.
        </p>
        <div class="stackRow">
          {products.map((p, i) => (
            <a
              href={productPaths[p.id] || `#${p.id}`}
              class:list={['stackChip', { stackChipHot: p.id === 'niceraiplus' }]}
              style={`--revealDelay: ${i * 0.08}s`}
              data-scroll-reveal
            >
              {p.name}
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Quick Navigation Dock / Rounded Frame */
  .floatStrip {
    padding: 2rem 1.5rem 1.5rem;
    background: var(--colorWhite);
  }

  .dockContainer {
    max-width: 860px;
    margin: 0 auto;
    background: linear-gradient(180deg, #ffffff 0%, #fafbfe 100%);
    border: 1px solid var(--colorBorder);
    border-radius: 24px;
    padding: 1.25rem 2rem;
    box-shadow: 0 8px 30px rgba(10, 10, 11, 0.06);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .dockLabel {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--colorBrand);
    white-space: nowrap;
  }

  .dockRow {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    flex-wrap: wrap;
  }

  .dockItem {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    transition: transform 0.25s var(--easeOutExpo);
  }

  .dockItem:hover {
    transform: translateY(-4px);
  }

  .dockBubble {
    width: 58px;
    height: 58px;
    border-radius: 16px;
    overflow: hidden;
    background: #000;
    border: 2px solid #ffffff;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: box-shadow 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .dockItem:hover .dockBubble {
    border-color: var(--itemAccent, var(--colorBrand));
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.15);
    transform: scale(1.05);
  }

  .dockLogo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .dockName {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--colorText);
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .dockItem:hover .dockName {
    color: var(--colorBrand);
  }

  /* Products Showcase Section */
  .productsSection {
    padding: 3rem 2rem 5rem;
    background: var(--colorWhite);
  }

  .productsSectionAfter {
    padding-top: 4rem;
  }

  .productsList {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .productBlock {
    background: linear-gradient(180deg, var(--colorSurfaceElevated) 0%, #ffffff 100%);
    border: 1px solid var(--colorBorder);
    border-radius: var(--radiusLg);
    padding: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    box-shadow: var(--shadowSoft);
    transition: transform 0.3s var(--easeOutExpo), box-shadow 0.3s var(--easeOutExpo);
    scroll-margin-top: calc(var(--headerHeight) + 24px);
  }

  .productBlock:hover {
    box-shadow: var(--shadowLift);
  }

  .productBlock.reverse {
    grid-template-columns: minmax(0, 1fr) 180px;
  }

  .productBlock.reverse .productMediaCol {
    order: 2;
  }

  .productBlock.reverse .productCopy {
    order: 1;
  }

  .productMediaCol {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .productFloat {
    display: block;
    width: 148px;
    height: 148px;
    border-radius: 28px;
    overflow: hidden;
    background: #000;
    position: relative;
    border: 3px solid #ffffff;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
    transition: transform 0.35s var(--easeOutExpo), box-shadow 0.35s ease;
    flex-shrink: 0;
  }

  .productFloat:hover {
    transform: translateY(-6px) scale(1.04);
    box-shadow: 0 22px 46px rgba(0, 0, 0, 0.18);
  }

  .productLogo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: relative;
    z-index: 2;
  }

  .productFloatGlow {
    position: absolute;
    inset: 0;
    opacity: 0.15;
    z-index: 1;
    pointer-events: none;
  }

  .productCopy {
    display: flex;
    flex-direction: column;
  }

  .productAccent {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .productTitle {
    font-family: var(--fontDisplay);
    font-size: clamp(1.75rem, 3.5vw, 2.35rem);
    font-weight: 700;
    color: var(--colorInk);
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .productDesc {
    font-size: 1.025rem;
    line-height: 1.7;
    color: var(--colorText);
    margin-bottom: 1.5rem;
  }

  .featureList {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem 1.5rem;
    margin-bottom: 2rem;
  }

  .featureList li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--colorInk);
  }

  .check {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .productLinks {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  /* Unified Stack Section */
  .stackSection {
    padding: 5rem 2rem;
    background: var(--colorSurface);
  }

  .stackInner {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .stackInner .sectionLead {
    margin: 0 auto 2.5rem;
  }

  .stackRow {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }

  .stackChip {
    padding: 0.75rem 1.4rem;
    font-family: var(--fontDisplay);
    font-weight: 700;
    font-size: 0.925rem;
    color: var(--colorInk);
    background: var(--colorWhite);
    border: 1px solid var(--colorBorder);
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
    transition:
      transform 0.25s var(--easeOutExpo),
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      color 0.25s ease;
  }

  .stackChip:hover {
    transform: translateY(-3px);
    color: var(--colorBrand);
    border-color: rgba(237, 53, 66, 0.3);
    box-shadow: var(--shadowSoft);
  }

  .stackChipHot {
    color: #ffffff;
    background: linear-gradient(135deg, #7c5cfc, #ED3542);
    border-color: transparent;
    box-shadow: 0 6px 20px rgba(237, 53, 66, 0.25);
  }

  .stackChipHot:hover {
    color: #ffffff;
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 10px 28px rgba(124, 92, 252, 0.35);
  }

  @media (max-width: 900px) {
    .dockContainer {
      justify-content: center;
      text-align: center;
    }

    .productBlock,
    .productBlock.reverse {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2rem;
    }

    .productBlock.reverse .productMediaCol,
    .productBlock.reverse .productCopy {
      order: unset;
    }

    .productLinks {
      justify-content: center;
    }

    .featureList {
      justify-items: center;
    }
  }

  @media (max-width: 640px) {
    .dockContainer {
      padding: 1rem;
      border-radius: 18px;
    }

    .dockBubble {
      width: 48px;
      height: 48px;
      border-radius: 12px;
    }

    .productFloat {
      width: 120px;
      height: 120px;
      border-radius: 22px;
    }

    .productsSection {
      padding: 2rem 1rem 4rem;
    }
  }
</style>
