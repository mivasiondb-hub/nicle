---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { helpProducts } from '../../data/helpData';

// Import logos for the products
import nicerwaveImage from '../../assets/images/nicerwave.png';
import mivasionImage from '../../assets/images/mivasion-fit.jpeg';
import worldnicerImage from '../../assets/images/worldnicer-fit.jpeg';
import nicerappImage from '../../assets/images/nicerapp-fit.jpeg';
import chatnicerImage from '../../assets/images/chatnicer-fit.webp';
import nicerAiPlusImage from '../../assets/images/nicer-ai-plus-fit.jpeg';

export function getStaticPaths() {
  return helpProducts.map((product) => ({
    params: { product: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;

const productLogos: Record<string, ImageMetadata> = {
  nicerwave: nicerwaveImage,
  worldnicer: worldnicerImage,
  nicerapp: nicerappImage,
  mivasion: mivasionImage,
  niceraiplus: nicerAiPlusImage,
  chatnicer: chatnicerImage,
};

const logo = productLogos[product.logoKey];

// Group articles by category
const categories = [...new Set(product.articles.map((a) => a.category))];
---

<BaseLayout
  title={`${product.name} Support | Help Center`}
  description={`Troubleshooting guides, FAQs, and support articles for ${product.name}. Learn how to configure your account, settings, and privacy.`}
  activeNav="contact"
  image="/og-default.png"
  canonical={`/help/${product.id}`}
  keywords={`${product.name} support, ${product.name} help, ${product.name} guide, FAQs`}
>
  <Header active="contact" />

  <main class="hcpMain">
    <!-- Header Area -->
    <section class="hcpHero">
      <div class="hcpHeroInner" data-scroll-reveal>
        <div class="hcpBreadcrumbs">
          <a href="/help">Help Center</a>
          <span class="separator">/</span>
          <span class="active">{product.name}</span>
        </div>
        
        <div class="hcpHeaderRow">
          <div class="hcpLogoFrame" style={`box-shadow: 0 10px 24px rgba(0,0,0,0.1), 0 0 30px ${product.accent}44`}>
            {logo && (
              <Image 
                src={logo} 
                alt={`${product.name} Logo`} 
                class="hcpLogo"
                widths={[120, 180]}
                sizes="80px"
                formats={['avif', 'webp']}
              />
            )}
          </div>
          <div class="hcpHeaderCopy">
            <h1 class="hcpTitle">{product.name} Help</h1>
            <p class="hcpTagline">{product.tagline}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Support Content Sections -->
    <section class="hcpContent">
      <div class="hcpContentInner" data-scroll-reveal>
        <div class="hcpGrid">
          <div class="hcpArticlesCol">
            {categories.map((category) => {
              const categoryArticles = product.articles.filter((a) => a.category === category);
              return (
                <div class="hcpCategoryGroup">
                  <h2 class="hcpCategoryTitle">{category}</h2>
                  <div class="hcpArticlesList">
                    {categoryArticles.map((article) => (
                      <a href={`/help/${product.id}/${article.id}`} class="hcpArticleLink">
                        <span class="hcpArticleIcon">
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                          </svg>
                        </span>
                        <div class="hcpArticleLinkCopy">
                          <strong>{article.title}</strong>
                          <p>{article.description}</p>
                        </div>
                        <span class="hcpArticleArrow">
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="9 18 15 12 9 6"></polyline>
                          </svg>
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>

          <!-- Quick Actions / Sidebar -->
          <aside class="hcpSidebar">
            <div class="hcpSidebarCard">
              <h3>Still need support?</h3>
              <p>Send an email containing your account username and details to our support team.</p>
              <a href={`mailto:we@nicleinc.com?subject=[${product.name} Help] Inquiry`} class="btnPrimary">
                Email Nicle Support
              </a>
            </div>
            <div class="hcpSidebarCard hcpSidebarInfoCard">
              <h3>Product Resources</h3>
              <ul>
                <li><a href={product.id === 'nicerapp' ? '/nicerapp' : product.id === 'nicerwave' ? '/nicerwave' : product.id === 'niceraiplus' ? '/nicer-ai-plus' : '/products'}>Visit Product Page</a></li>
                <li><a href="/security">Security &amp; Encryption Specs</a></li>
                {product.id === 'nicerapp' && (
                  <>
                    <li><a href="https://nicerapp.cloud/web/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a></li>
                    <li><a href="https://nicerapp.cloud/web/terms" target="_blank" rel="noopener noreferrer">Terms of Service</a></li>
                  </>
                )}
                <li><a href="/about">About Nicle Inc</a></li>
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hcpMain {
    background: var(--colorWhite);
    min-height: calc(100vh - var(--headerHeight));
  }

  /* Header Section */
  .hcpHero {
    padding: calc(var(--headerHeight) + 4rem) 1.5rem 3rem;
    background: linear-gradient(180deg, rgba(245, 246, 248, 0.4) 0%, var(--colorWhite) 100%);
    border-bottom: 1px solid var(--colorBorder);
  }

  .hcpHeroInner {
    max-width: 1080px;
    margin: 0 auto;
  }

  .hcpBreadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--colorTextMuted);
    margin-bottom: 1.5rem;
  }

  .hcpBreadcrumbs a {
    color: var(--colorTextMuted);
    transition: color 0.2s ease;
  }

  .hcpBreadcrumbs a:hover {
    color: var(--colorBrand);
  }

  .hcpBreadcrumbs .separator {
    color: var(--colorBorder);
  }

  .hcpBreadcrumbs .active {
    color: var(--colorInk);
  }

  .hcpHeaderRow {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .hcpLogoFrame {
    width: 84px;
    height: 84px;
    border-radius: 20px;
    overflow: hidden;
    background: #000;
    border: 3px solid var(--colorWhite);
    flex-shrink: 0;
  }

  .hcpLogo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hcpTitle {
    font-family: var(--fontDisplay);
    font-size: clamp(1.85rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--colorInk);
    line-height: 1.15;
    margin-bottom: 0.35rem;
  }

  .hcpTagline {
    font-size: 1.05rem;
    color: var(--colorTextMuted);
    font-weight: 500;
  }

  /* Content Columns Grid */
  .hcpContent {
    padding: 3.5rem 1.5rem 6rem;
  }

  .hcpContentInner {
    max-width: 1080px;
    margin: 0 auto;
  }

  .hcpGrid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3.5rem;
    align-items: start;
  }

  .hcpCategoryGroup {
    margin-bottom: 3rem;
  }

  .hcpCategoryGroup:last-child {
    margin-bottom: 0;
  }

  .hcpCategoryTitle {
    font-family: var(--fontDisplay);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--colorInk);
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--colorBorder);
    padding-bottom: 0.5rem;
  }

  .hcpArticlesList {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hcpArticleLink {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    padding: 1.25rem 1.5rem;
    border-radius: 14px;
    border: 1px solid var(--colorBorder);
    background: var(--colorWhite);
    transition: transform 0.3s var(--easeOutExpo), border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .hcpArticleLink:hover {
    transform: translateY(-2px);
    border-color: rgba(237, 53, 66, 0.22);
    box-shadow: 0 8px 24px rgba(10, 10, 11, 0.04);
  }

  .hcpArticleIcon {
    color: var(--colorTextMuted);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .hcpArticleLink:hover .hcpArticleIcon {
    color: var(--colorBrand);
  }

  .hcpArticleLinkCopy {
    flex-grow: 1;
  }

  .hcpArticleLinkCopy strong {
    display: block;
    font-size: 1.05rem;
    color: var(--colorInk);
    margin-bottom: 0.25rem;
  }

  .hcpArticleLinkCopy p {
    font-size: 0.88rem;
    color: var(--colorTextMuted);
    line-height: 1.45;
  }

  .hcpArticleArrow {
    color: var(--colorBorder);
    display: grid;
    place-items: center;
    transition: transform 0.3s var(--easeOutExpo), color 0.25s ease;
    flex-shrink: 0;
  }

  .hcpArticleLink:hover .hcpArticleArrow {
    color: var(--colorBrand);
    transform: translateX(4px);
  }

  /* Sidebar details */
  .hcpSidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hcpSidebarCard {
    padding: 2rem 1.75rem;
    border-radius: 18px;
    background: var(--colorSurface);
    border: 1px solid var(--colorBorder);
  }

  .hcpSidebarCard h3 {
    font-family: var(--fontDisplay);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--colorInk);
    margin-bottom: 0.65rem;
  }

  .hcpSidebarCard p {
    font-size: 0.9rem;
    color: var(--colorTextMuted);
    line-height: 1.55;
    margin-bottom: 1.5rem;
  }

  .hcpSidebarCard .btnPrimary {
    width: 100%;
    font-size: 0.875rem;
    padding: 0.8rem 1.25rem;
  }

  .hcpSidebarInfoCard {
    background: var(--colorWhite);
  }

  .hcpSidebarInfoCard ul {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .hcpSidebarInfoCard li {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .hcpSidebarInfoCard a {
    color: var(--colorBrand);
    transition: opacity 0.2s ease;
  }

  .hcpSidebarInfoCard a:hover {
    opacity: 0.8;
  }

  @media (max-width: 900px) {
    .hcpGrid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 640px) {
    .hcpHero {
      padding-top: calc(var(--headerHeight) + 3rem);
    }

    .hcpHeaderRow {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .hcpLogoFrame {
      width: 72px;
      height: 72px;
      border-radius: 16px;
    }

    .hcpArticleLink {
      padding: 1.15rem 1rem;
      gap: 0.85rem;
    }
  }
</style>
