---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
import NicerAiPlusShowcase from '../components/NicerAiPlusShowcase.astro';
import { products } from '../data/site';
import { serviceHubSeo, getProductSeo, buildProductSchema } from '../data/productSeo';

const ai = products.find((p) => p.id === 'niceraiplus')!;
const aiSeo = getProductSeo('nicer-ai-plus')!;
const hub = serviceHubSeo.intelligence;

const models = ['Miva 2.5', 'Miva 3.5 Flash', 'Miva 4.5', 'Divi 1B', 'HC Ultra 1'];

const useCases = [
  {
    title: 'Chat, talk and code',
    text: 'Chat or talk by voice, and get help writing and fixing code.',
  },
  {
    title: 'Documents and files',
    text: 'Analyze documents and uploaded files, and write new documents.',
  },
  {
    title: 'Images and music',
    text: 'Create images, edit photos and make music.',
  },
  {
    title: 'A companion for life',
    text: 'A life coach, creative partner, best friend, mood tracker or dream interpreter.',
  },
];
---

<BaseLayout
  title={hub.title}
  description={hub.description}
  activeNav="products"
  image={aiSeo.image}
  imageAlt={aiSeo.imageAlt}
  canonical={hub.path}
  keywords={hub.keywords}
  jsonLd={buildProductSchema(aiSeo)}
>
  <Header active="products" />
  <main>
    <PageHero
      label="Nicer AI"
      title='Our own AI, <span class="accent">built to help you</span>'
      subtitle="Nicer AI is Nicle’s family of AI models. nicer ai plus is the assistant built on them, available inside nicerapp and nicerwave."
      primaryCta={{ label: 'See nicer ai plus', href: '/nicer-ai-plus' }}
      secondaryCta={{ label: 'Social platforms', href: '/social' }}
    />

    <section class="aiMeta">
      <div class="aiMetaInner" data-scroll-reveal>
        <div class="aiMetaCard">
          <span>Product</span>
          <strong>{ai.name}</strong>
        </div>
        <div class="aiMetaCard">
          <span>Focus</span>
          <strong>{ai.tagline}</strong>
        </div>
        <div class="aiMetaCard">
          <span>Capabilities</span>
          <strong>{ai.features.length} core modes</strong>
        </div>
      </div>
      <div class="aiModels" data-scroll-reveal>
        <span class="aiModelsLabel">The Nicer AI model family</span>
        <ul>
          {models.map((m) => <li>{m}</li>)}
        </ul>
      </div>
    </section>

    <section class="useSection">
      <div class="useInner">
        <div class="useHeader" data-scroll-reveal>
          <span class="sectionLabel">What you can do</span>
          <h2 class="sectionTitle">One assistant, many ways to help</h2>
          <p class="sectionLead">
            nicer ai plus runs on the Nicer AI models and lives inside nicerapp and nicerwave. Here is what it can do.
          </p>
        </div>
        <div class="useGrid">
          {useCases.map((item, i) => (
            <article class="useCard" data-scroll-reveal style={`--revealDelay: ${i * 0.08}s`}>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <div id="showcase">
      <NicerAiPlusShowcase />
    </div>

    <section class="aiCta" data-scroll-reveal>
      <h2>Want the full product map?</h2>
      <p>See every platform in the Nicer ecosystem, or try nicerapp voice messaging next.</p>
      <div class="aiCtaActions">
        <a href="/nicer-ai-plus" class="btnPrimary">nicer ai plus</a>
        <a href="/security" class="btnOutline darkOutline">Security hub</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>


<style>
  .aiMeta {
    padding: 0 2rem 2rem;
    background: var(--colorCard);
  }

  .aiModels {
    max-width: 1000px;
    margin: 1.25rem auto 0;
    text-align: center;
  }

  .aiModelsLabel {
    display: block;
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--colorTextMuted);
  }

  .aiModels ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }

  .aiModels li {
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--colorBorder);
    border-radius: 999px;
    background: var(--colorSurfaceElevated);
    color: var(--colorInk);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .aiMetaInner {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .aiMetaCard {
    padding: 1.35rem 1.5rem;
    border-radius: var(--radiusMd);
    border: 1px solid var(--colorBorder);
    background: var(--colorSurface);
  }

  .aiMetaCard span {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--colorTextMuted);
    margin-bottom: 0.35rem;
  }

  .aiMetaCard strong {
    font-family: var(--fontDisplay);
    font-size: 1.15rem;
    color: var(--colorInk);
  }

  .useSection {
    padding: 3rem 2rem 4rem;
    background: var(--colorSurface);
  }

  .useInner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .useHeader {
    max-width: 640px;
    margin-bottom: 2.5rem;
  }

  .useGrid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .useCard {
    padding: 1.75rem;
    border-radius: var(--radiusMd);
    background: var(--colorCard);
    border: 1px solid var(--colorBorder);
    transition: transform 0.4s var(--easeOutExpo), box-shadow 0.4s ease;
  }

  .useCard:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadowSoft);
  }

  .useCard h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .useCard p {
    color: var(--colorTextMuted);
    font-size: 0.95rem;
  }

  .aiCta {
    max-width: 900px;
    margin: 0 auto 5rem;
    padding: 3rem 2rem;
    text-align: center;
    border-radius: var(--radiusLg);
    background: linear-gradient(135deg, #0e1420, #1a1028 55%, #ED3542);
    color: white;
  }

  .aiCta h2 {
    color: white;
    margin-bottom: 0.65rem;
  }

  .aiCta p {
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 1.5rem;
  }

  .aiCtaActions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .darkOutline {
    border-color: rgba(255, 255, 255, 0.28);
  }

  @media (max-width: 800px) {
    .aiMetaInner,
    .useGrid {
      grid-template-columns: 1fr;
    }
  }
</style>
