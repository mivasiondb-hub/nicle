---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { leadership, buildLeaderKnowledgeGraphJsonLd, type LeadershipPerson } from '../../data/leadership';
import { siteUrl } from '../../data/seo';

export function getStaticPaths() {
  return leadership.map((person) => ({
    params: { slug: person.slug },
    props: { person },
  }));
}

interface Props {
  person: LeadershipPerson;
}

const { person } = Astro.props;

const jsonLd = buildLeaderKnowledgeGraphJsonLd(person, siteUrl);

const pageTitle = `${person.name} - Biography & Executive Profile`;
const pageDescription = `Official biography and career overview for ${person.name}, ${person.role}. Companies founded, platforms developed, and contributions to the Nicer Ecosystem.`;

const isFounder = person.slug === 'highness-hc' || person.slug === 'justice-friday';
const otherLeaders = leadership.filter((l) => l.slug !== person.slug);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  activeNav="team"
  image={person.photo || '/og-default.png'}
  imageAlt={`${person.name} - ${person.role}`}
  canonical={`/team/${person.slug}`}
  keywords={`${person.name}, ${person.fullName || ''}, ${person.role}, Nicle Inc, All Things Web Technology, Knowledge Graph, founder, biography, tech leadership`}
  jsonLd={jsonLd}
>
  <Header active="team" />

  <main class="kgPage">
    <!-- Breadcrumb Bar -->
    <nav class="kgBreadcrumbNav" aria-label="Breadcrumb">
      <div class="kgContainer">
        <ol class="kgBreadcrumbList">
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">&rsaquo;</li>
          <li><a href="/team">Team</a></li>
          <li aria-hidden="true">&rsaquo;</li>
          <li aria-current="page" class="active">{person.name}</li>
        </ol>
      </div>
    </nav>

    <!-- Entity Hero Banner -->
    <header class="kgHeroSection">
      <div class="kgContainer kgHeroInner">

        <div class="kgHeroContent">
          <div
            class:list={['kgHeroAvatar', { kgHeroAvatarPhoto: !!person.photo }]}
            style={!person.photo ? `background: ${person.gradient}` : undefined}
          >
            {person.photo ? (
              <img src={person.photo} alt={person.name} class="kgAvatarImg" width="220" height="220" loading="eager" />
            ) : (
              <span>{person.initials}</span>
            )}
            <div class="kgAvatarRing" aria-hidden="true"></div>
          </div>

          <div class="kgHeroMeta">
            <div class="kgRoleTagRow">
              <span class="kgEntityTag">{isFounder ? 'Key Founder' : 'Executive Leadership'}</span>
              <span class="kgIdTag">Entity ID: {person.slug}</span>
            </div>

            <h1 class="kgEntityTitle">{person.name}</h1>
            {person.fullName && person.fullName !== person.name && (
              <p class="kgAlternateName">Full Name: <strong>{person.fullName}</strong></p>
            )}
            <p class="kgEntityRole">{person.role}</p>

            {person.headline && (
              <p class="kgEntityHeadline">{person.headline}</p>
            )}

            <div class="kgTagCloud">
              {person.tags.map((tag) => (
                <span class="kgTag">{tag}</span>
              ))}
            </div>

            <div class="kgHeroActions">
              <a href="#quick-facts" class="kgBtnPrimary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                View Key Facts
              </a>
              <a href="/team" class="kgBtnOutline">
                &larr; All Team Members
              </a>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Dossier Layout -->
    <div class="kgContainer kgMainLayout">
      <!-- Left Column: Comprehensive Biographical & Achievement Dossier -->
      <section class="kgMainContent">
        <!-- Biography Section -->
        <article class="kgCard">
          <div class="kgCardHeader">
            <span class="kgCardPretitle">Biographical Overview</span>
            <h2 class="kgCardTitle">About {person.name}</h2>
          </div>
          <div class="kgBioBody">
            {person.bio.map((para) => (
              <p>{para}</p>
            ))}
          </div>
        </article>

        <!-- Companies & Ventures Founded / Managed -->
        {person.companies && person.companies.length > 0 && (
          <article class="kgCard">
            <div class="kgCardHeader">
              <span class="kgCardPretitle">Corporate Ecosystem</span>
              <h2 class="kgCardTitle">Companies &amp; Ventures Founded</h2>
            </div>
            <div class="kgCompanyGrid">
              {person.companies.map((company) => (
                <div class="kgCompanyCard">
                  <div class="kgCompanyCardTop">
                    <h3>{company.name}</h3>
                    <span class="kgCompanyFounded">Founded {company.founded}</span>
                  </div>
                  <p class="kgCompanyTitle">{company.title}</p>
                  <p class="kgCompanyDetail">{company.detail}</p>
                </div>
              ))}
            </div>
          </article>
        )}

        <!-- Platforms Developed & Software Innovations -->
        {person.platforms && person.platforms.length > 0 && (
          <article class="kgCard">
            <div class="kgCardHeader">
              <span class="kgCardPretitle">Technical Inventions</span>
              <h2 class="kgCardTitle">Legendary Platforms &amp; Software Ecosystem</h2>
            </div>
            <p class="kgSectionLead">
              Software platforms engineered and architected under the leadership of {person.name}, powering next-generation AI, communication, and digital interaction worldwide.
            </p>
            <div class="kgPlatformCloud">
              {person.platforms.map((plat) => (
                <div class="kgPlatformBadge">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <span>{plat}</span>
                </div>
              ))}
            </div>
          </article>
        )}

        <!-- AI Metropolis & Synthetic Beings (Mr. Highness HC) -->
        {person.cityNote && (
          <article class="kgCard kgCardHighlight">
            <div class="kgCardHeader">
              <span class="kgCardPretitle">Autonomous AI Innovation</span>
              <h2 class="kgCardTitle">The Nicer City &amp; Virtual Metropolis</h2>
            </div>
            <p class="kgCityNote">{person.cityNote}</p>
            {person.cityNetwork && (
              <p class="kgCityNetwork">{person.cityNetwork}</p>
            )}

            {person.characters && person.characters.length > 0 && (
              <div class="kgCharactersSection">
                <h3 class="kgSubhead">Notable Autonomous AI Characters &amp; Beings</h3>
                <div class="kgCharacterPills">
                  {person.characters.map((char) => (
                    <span class="kgCharPill">{char}</span>
                  ))}
                  <span class="kgCharPill kgCharPillMore">+ Extended AI Beings</span>
                </div>
              </div>
            )}
          </article>
        )}

        <!-- Creative Endeavors (Music & Film) -->
        {(person.music || person.film) && (
          <article class="kgCard">
            <div class="kgCardHeader">
              <span class="kgCardPretitle">Creative Arts &amp; Entertainment</span>
              <h2 class="kgCardTitle">Creative Portfolio &amp; Media Production</h2>
            </div>
            <div class="kgMediaSplit">
              {person.music && (
                <div class="kgMediaBlock">
                  <div class="kgMediaIcon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M9 18V5l12-2v13"></path>
                      <circle cx="6" cy="18" r="3"></circle>
                      <circle cx="18" cy="16" r="3"></circle>
                    </svg>
                  </div>
                  <h3>Music Industry Innovation (Hc Music)</h3>
                  <p>Directing music composition, sound engineering, record production, and artist development.</p>
                  <div class="kgMediaTags">
                    {person.music.map((m) => (
                      <span>{m}</span>
                    ))}
                  </div>
                </div>
              )}

              {person.film && (
                <div class="kgMediaBlock">
                  <div class="kgMediaIcon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
                      <line x1="7" y1="2" x2="7" y2="22"></line>
                      <line x1="17" y1="2" x2="17" y2="22"></line>
                      <line x1="2" y1="12" x2="22" y2="12"></line>
                    </svg>
                  </div>
                  <h3>Film &amp; Visual Arts (Hc Studios Picture)</h3>
                  <p>Directing cinematic visual narratives, storytelling, screenwriting, and digital media production.</p>
                  <div class="kgMediaTags">
                    {person.film.map((f) => (
                      <span>{f}</span>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </article>
        )}

        <!-- Responsibilities & Achievements -->
        {(person.responsibilities || person.achievements) && (
          <article class="kgCard">
            <div class="kgCardHeader">
              <span class="kgCardPretitle">Executive Execution</span>
              <h2 class="kgCardTitle">Operational Mandate &amp; Achievements</h2>
            </div>
            <div class="kgExecSplit">
              {person.responsibilities && (
                <div class="kgExecBlock">
                  <h3>Key Responsibilities</h3>
                  <ul class="kgCheckList">
                    {person.responsibilities.map((r) => (
                      <li>{r}</li>
                    ))}
                  </ul>
                </div>
              )}
              {person.achievements && (
                <div class="kgExecBlock">
                  <h3>Key Achievements &amp; Milestones</h3>
                  <ul class="kgStarList">
                    {person.achievements.map((a) => (
                      <li>{a}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </article>
        )}

        <!-- Legacy & Impact Statement -->
        {person.legacy && (
          <article class="kgCard kgLegacyCard">
            <span class="kgCardPretitle">Legacy &amp; Global Vision</span>
            <h2 class="kgCardTitle">Strategic Impact</h2>
            <blockquote class="kgQuote">
              &ldquo;{person.legacy}&rdquo;
            </blockquote>
          </article>
        )}

        <!-- Search Engine Data & Schema Inspector -->
        <article class="kgCard kgSchemaCard">
          <div class="kgCardHeader">
            <span class="kgCardPretitle">Semantic Web &middot; SEO Architecture</span>
            <h2 class="kgCardTitle">Knowledge Graph Data Feeding Search Engines</h2>
          </div>
          <p class="kgSchemaIntro">
            This entity page is embedded with Google-standard <code>Schema.org/Person</code> and <code>Schema.org/ProfilePage</code> JSON-LD structured data to index official facts and verify entity relationships.
          </p>
          <div class="kgSchemaGrid">
            <div class="kgSchemaItem">
              <span class="kgSchemaKey">@type</span>
              <span class="kgSchemaVal">Person &middot; ProfilePage</span>
            </div>
            <div class="kgSchemaItem">
              <span class="kgSchemaKey">Entity Canonical URI</span>
              <span class="kgSchemaVal">{siteUrl}/team/{person.slug}</span>
            </div>
            <div class="kgSchemaItem">
              <span class="kgSchemaKey">Parent Organization</span>
              <span class="kgSchemaVal">All Things Web Technology Inc.</span>
            </div>
            <div class="kgSchemaItem">
              <span class="kgSchemaKey">Affiliated Subsidiary</span>
              <span class="kgSchemaVal">Nicle Inc.</span>
            </div>
            {person.knowsAbout && (
              <div class="kgSchemaItem">
                <span class="kgSchemaKey">knowsAbout</span>
                <span class="kgSchemaVal">{person.knowsAbout.join(', ')}</span>
              </div>
            )}
          </div>
        </article>
      </section>

      <!-- Right Column: Google Knowledge Panel Key Facts Sidebar -->
      <aside class="kgSidebar" id="quick-facts">
        <!-- Google Knowledge Panel Card -->
        <div class="kgPanelCard">
          <div class="kgPanelHeader">
            <div class="kgPanelLogoRow">
              <span class="kgPanelLogo">Knowledge Panel</span>
              <span class="kgVerifiedChip">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
                Verified
              </span>
            </div>
            <h3 class="kgPanelTitle">{person.name}</h3>
            <p class="kgPanelSubtitle">{person.role.split('·')[0]}</p>
          </div>

          <div class="kgPanelBody">
            <h4 class="kgPanelSectionLabel">Quick Facts</h4>
            <dl class="kgFactsList">
              {person.keyFacts ? (
                person.keyFacts.map((fact) => (
                  <div class="kgFactRow">
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </div>
                ))
              ) : (
                <>
                  <div class="kgFactRow">
                    <dt>Full Name</dt>
                    <dd>{person.fullName || person.name}</dd>
                  </div>
                  <div class="kgFactRow">
                    <dt>Title</dt>
                    <dd>{person.role}</dd>
                  </div>
                  <div class="kgFactRow">
                    <dt>Organization</dt>
                    <dd>Nicle Inc. &amp; All Things Web Technology Inc.</dd>
                  </div>
                </>
              )}
              {person.nationality && (
                <div class="kgFactRow">
                  <dt>Nationality</dt>
                  <dd>{person.nationality}</dd>
                </div>
              )}
            </dl>
          </div>

          {person.sameAs && person.sameAs.length > 0 && (
            <div class="kgPanelProfiles">
              <h4 class="kgPanelSectionLabel">Official Web References</h4>
              <ul class="kgProfileLinks">
                {person.sameAs.map((link) => (
                  <li>
                    <a href={link} target="_blank" rel="noopener noreferrer">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                      </svg>
                      {link.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <!-- Related Leadership Panel -->
        <div class="kgPanelCard">
          <div class="kgPanelHeader">
            <h4 class="kgPanelSectionLabel">Nicle Executive Leadership</h4>
          </div>
          <div class="kgRelatedList">
            {otherLeaders.map((leader) => (
              <a href={`/team/${leader.slug}`} class="kgRelatedItem">
                <div
                  class="kgRelatedAvatar"
                  style={!leader.photo ? `background: ${leader.gradient}` : undefined}
                >
                  {leader.photo ? (
                    <img src={leader.photo} alt={leader.name} width="40" height="40" loading="lazy" />
                  ) : (
                    <span>{leader.initials}</span>
                  )}
                </div>
                <div class="kgRelatedMeta">
                  <strong>{leader.name}</strong>
                  <span>{leader.role.split('·')[0]}</span>
                </div>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M9 18l6-6-6-6"/>
                </svg>
              </a>
            ))}
          </div>
        </div>

        <!-- Navigation Action Card -->
        <div class="kgPanelCard kgCtaCard">
          <h4>Explore Nicle Platforms</h4>
          <p>Discover AI models, encrypted messaging, and social computing platforms built by our team.</p>
          <a href="/products" class="kgBtnFull">Explore All Products &rarr;</a>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .kgPage {
    background: #f8f9fc;
    color: var(--colorText);
    min-height: 100vh;
    padding-bottom: 5rem;
  }

  .kgContainer {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Breadcrumbs */
  .kgBreadcrumbNav {
    background: #ffffff;
    border-bottom: 1px solid var(--colorBorder);
    padding: 0.85rem 0;
    font-size: 0.875rem;
  }

  .kgBreadcrumbList {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--colorTextMuted);
  }

  .kgBreadcrumbList a {
    color: var(--colorTextMuted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .kgBreadcrumbList a:hover {
    color: var(--colorBrand);
  }

  .kgBreadcrumbList .active {
    color: var(--colorInk);
    font-weight: 600;
  }

  /* Verified Hero Section */
  .kgHeroSection {
    background: linear-gradient(180deg, #ffffff 0%, #f4f6fb 100%);
    border-bottom: 1px solid var(--colorBorder);
    padding: 3rem 0 3.5rem;
  }

  .kgVerifiedBadge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.95rem;
    background: rgba(46, 117, 246, 0.08);
    color: #1a73e8;
    border: 1px solid rgba(26, 115, 232, 0.25);
    border-radius: 100px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    margin-bottom: 2rem;
  }

  .verifiedIcon {
    color: #1a73e8;
  }

  .kgHeroContent {
    display: flex;
    gap: 2.75rem;
    align-items: flex-start;
  }

  .kgHeroAvatar {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    position: relative;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
    border: 4px solid #ffffff;
    overflow: hidden;
  }

  .kgHeroAvatar span {
    font-family: var(--fontDisplay);
    font-size: 3.5rem;
    font-weight: 800;
    color: #ffffff;
  }

  .kgAvatarImg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kgAvatarRing {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid rgba(237, 53, 66, 0.35);
    pointer-events: none;
  }

  .kgHeroMeta {
    flex: 1;
  }

  .kgRoleTagRow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .kgEntityTag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    background: var(--colorBrandSoft);
    color: var(--colorBrand);
  }

  .kgIdTag {
    font-size: 0.75rem;
    color: var(--colorTextMuted);
    font-family: monospace;
  }

  .kgEntityTitle {
    font-family: var(--fontDisplay);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--colorInk);
    line-height: 1.15;
    margin-bottom: 0.35rem;
    letter-spacing: -0.02em;
  }

  .kgAlternateName {
    font-size: 0.95rem;
    color: var(--colorTextMuted);
    margin-bottom: 0.35rem;
  }

  .kgEntityRole {
    font-size: 1.05rem;
    color: var(--colorText);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .kgEntityHeadline {
    font-size: 1.05rem;
    color: var(--colorTextMuted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 800px;
  }

  .kgTagCloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }

  .kgTag {
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    background: #ffffff;
    border: 1px solid var(--colorBorder);
    border-radius: 100px;
    color: var(--colorInk);
  }

  .kgHeroActions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .kgBtnPrimary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.4rem;
    background: var(--colorBrand);
    color: #ffffff;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .kgBtnPrimary:hover {
    background: var(--colorBrandHover);
    transform: translateY(-1px);
  }

  .kgBtnOutline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.4rem;
    background: #ffffff;
    border: 1px solid var(--colorBorder);
    color: var(--colorInk);
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .kgBtnOutline:hover {
    border-color: var(--colorTextMuted);
    background: #f8f9fa;
  }

  /* Main Layout */
  .kgMainLayout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 2.5rem;
    margin-top: 2.5rem;
  }

  /* Cards */
  .kgMainContent {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .kgCard {
    background: #ffffff;
    border: 1px solid var(--colorBorder);
    border-radius: var(--radiusMd);
    padding: 2.25rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .kgCardHeader {
    margin-bottom: 1.5rem;
  }

  .kgCardPretitle {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--colorBrand);
    margin-bottom: 0.35rem;
  }

  .kgCardTitle {
    font-family: var(--fontDisplay);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--colorInk);
    letter-spacing: -0.01em;
  }

  .kgBioBody {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    font-size: 1.025rem;
    line-height: 1.8;
    color: var(--colorText);
  }

  .kgSectionLead {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--colorTextMuted);
    margin-bottom: 1.5rem;
  }

  /* Companies Grid */
  .kgCompanyGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .kgCompanyCard {
    background: #fafbfe;
    border: 1px solid var(--colorBorder);
    border-radius: 12px;
    padding: 1.35rem;
  }

  .kgCompanyCardTop {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.35rem;
  }

  .kgCompanyCardTop h3 {
