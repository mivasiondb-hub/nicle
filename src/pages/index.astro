---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FeatureCards from '../components/FeatureCards.astro';
import CompanyInfo from '../components/CompanyInfo.astro';
import NewsSection from '../components/NewsSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Nicle Inc | AI Software, Social Platforms & the Nicer Ecosystem"
  description="Nicle Inc builds AI models and intelligent software for the world — including worldnicer, nicerapp, Mivasion, nicer ai plus, and Chatnicer. A subsidiary of All Things Web Technology Inc."
  activeNav="home"
  image="/og-default.png"
  canonical="/"
  keywords="Nicle Inc, worldnicer, nicerapp, Mivasion, nicer ai plus, Chatnicer, AI company, Nicer Ecosystem"
>
  <Header active="" />
  <main>
    <Hero />
    <FeatureCards />
    <CompanyInfo />
    <NewsSection />
  </main>
  <Footer />
</BaseLayout>

