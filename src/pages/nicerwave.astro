---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getProductSeo, buildProductSchema, buildProductFaqSchema } from '../data/productSeo';
import nicerwaveImage from '../assets/images/nicerwave.png';

const product = getProductSeo('nicerwave')!;

const pillars = [
  {
    title: 'Friends first',
    text: 'Your feed starts with the people you follow. Enjoy authentic updates from people who matter without manipulative engagement traps.',
  },
  {
    title: 'Kindness built in',
    text: 'Clear community rules, pre-feed explicit content screening, safer link checks, and fair appeals designed for positive spaces.',
  },
  {
    title: 'Private by design',
    text: 'We never sell your personal information. Two-step PIN sign-in, login alerts, and transparent account controls keep you protected.',
  },
  {
    title: 'Made by Nicle',
    text: 'Engineered as the social cornerstone of the Nicer Ecosystem alongside encrypted nicerapp and conversational nicer ai plus.',
  },
];

const features = [
  {
    tag: 'Feed & Stories',
    title: 'See what your friends are up to.',
    lead: 'Post photos, swipeable albums, and updates, and share everyday moments in Stories that disappear after 24 hours.',
    bullets: [
      'Swipeable photo albums with multi-image layouts',
      '24-hour Stories with music, stickers, and friend mentions',
      'Memories that resurface your favorite moments from years ago',
    ],
  },
  {
    tag: 'Vins',
    title: 'Short videos, made to be shared.',
    lead: 'Record, trim, and add sounds in seconds. Discover Vins from creators you follow and exciting new voices you will love.',
    bullets: [
      'Trending sounds, audio mixing, and creative duets',
      'Built-in video editor with trimming and auto-captions',
      'Creator insights to track engagement and reach',
    ],
  },
  {
    tag: 'Messages & Calls',
    title: 'Talk the way friends talk.',
    lead: 'Instant chats, private groups, voice notes, and reactions — plus crisp voice and video calls whenever typing is not enough.',
    bullets: [
      'Group chats and crystal-clear voice and video calls',
      'Voice notes, high-res photos, documents, and GIFs',
      'Custom chat themes to personalize every conversation',
    ],
  },
  {
    tag: 'Nicer AI Plus',
    title: 'An assistant that lives in your chats.',
    lead: 'Ask questions, write and edit text, create images, and generate ready-to-download PDF or Word documents directly inside NicerWave.',
    bullets: [
      'Instant answers, writing assistance, and fluent translation',
      'Creative image generation and style editing',
      'Production-ready documents exported to PDF and Word format',
    ],
  },
  {
    tag: 'NicerWallet & Creators',
    title: 'Support the people you love to follow.',
    lead: 'Send gifts and tips, top up your NicerWallet securely, and apply for Nicle Verify to show you are the real you.',
    bullets: [
      'Direct gifts and tipping for favorite creators',
      'Secure top-ups by card and local payment methods',
      'Official Nicle Verify badges for eligible creators',
    ],
  },
  {
    tag: 'Safety & Protection',
    title: 'Built to keep you safe.',
    lead: 'Protection is part of how NicerWave works, not an afterthought. Every feature is tuned for user peace of mind.',
    bullets: [
      'Pre-feed automated content screening for explicit material',
      'Safer link scanner that warns before opening harmful external URLs',
      'Two-step PIN verification and instant report & block tools',
    ],
  },
];
---

<BaseLayout
  title={product.title}
  description={product.description}
  activeNav="products"
  image={product.image}
  imageAlt={product.imageAlt}
  type="product"
  canonical={product.path}
  keywords={product.keywords}
  jsonLd={[buildProductSchema(product), buildProductFaqSchema(product)]}
>
  <Header active="products" />
  <main class="nwPage">
    <!-- Hero Section -->
    <section class="nwHero">
      <div class="nwContainer nwHeroContent" data-scroll-reveal>
        <div class="nwLogoWrap">
          <Image
            src={nicerwaveImage}
            alt="NicerWave logo"
            class="nwHeroLogo"
            widths={[140, 200, 260]}
            sizes="120px"
            formats={['avif', 'webp']}
            quality={90}
            loading="eager"
            decoding="async"
          />
        </div>
        <span class="nwEyebrow">NicerWave Social App</span>
        <h1 class="nwTitle">Real friends.<br /><span class="nwAccent">Real moments.</span></h1>
        <p class="nwLead">
          Share what is happening, keep up with the people who matter, and talk the way friends do — in one app built for kinder conversations.
        </p>
        <div class="nwHeroActions">
          <a
            class="nwBtnPrimary"
            href="https://apps.apple.com/app/nicerbook/id6818673106"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 1.01-2.87-1 .04-2.17.67-2.86 1.47-.57.65-1.07 1.72-.94 2.76 1.12.09 2.18-.61 2.79-1.36z"/></svg>
            Download for iOS
          </a>
          <a
            class="nwBtnSecondary"
            href="https://play.google.com/store/apps/details?id=com.nicerbook.nicle"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.61 1.81 13.79 12 3.61 22.19a2 2 0 0 1-.61-.93V2.74c.16-.36.38-.68.61-.93zm11.6 11.61 2.25 2.25-11.45 6.47 9.2-8.72zm2.25-2.25-2.25 2.25-9.2-8.72 11.45 6.47zm1.42 1.42 2.84 1.6c.78.44.78 1.16 0 1.6l-2.84 1.6-2.03-2.4 2.03-2.4z"/></svg>
            Google Play
          </a>
        </div>
        <p class="nwHeroNote">Free on iPhone, Android, and web browsers worldwide.</p>
      </div>
    </section>

    <!-- Pillars Banner -->
    <section class="nwPillarsSection">
      <div class="nwContainer">
        <div class="nwPillarsGrid" data-scroll-reveal data-stagger>
          {pillars.map((p) => (
            <div class="nwPillarCard">
              <span class="nwPillarCheck">✓</span>
              <div>
                <h3 class="nwPillarTitle">{p.title}</h3>
                <p class="nwPillarText">{p.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Core Features Section -->
    <section class="nwFeaturesSection">
      <div class="nwContainer">
        <div class="nwSectionHead" data-scroll-reveal>
          <span class="nwEyebrow">Complete Feature Suite</span>
          <h2 class="nwSectionTitle">One app for the people you care about</h2>
          <p class="nwSectionLead">
            Everything you need for authentic connection, vibrant creator spaces, and kinder community conversations.
          </p>
        </div>

        <div class="nwFeaturesList">
          {features.map((item, index) => (
            <article
              class:list={['nwFeatureCard', { nwCardReverse: index % 2 === 1 }]}
              data-scroll-reveal
            >
              <div class="nwFeatureCopy">
                <span class="nwFeatureTag">{item.tag}</span>
                <h3 class="nwFeatureHeading">{item.title}</h3>
                <p class="nwFeatureLead">{item.lead}</p>
                <ul class="nwFeatureBullets">
                  {item.bullets.map((b) => (
                    <li>
                      <span class="nwBulletDot" aria-hidden="true"></span>
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="nwFeatureGraphic" aria-hidden="true">
                <div class="nwGraphicBadge">
                  <span class="nwBadgeIcon">✦</span>
                  <span class="nwBadgeText">{item.tag}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Download CTA Band -->
    <section class="nwCtaBand">
      <div class="nwContainer nwCtaInner" data-scroll-reveal>
        <h2 class="nwCtaTitle">Ready to experience <span class="nwAccent">NicerWave</span>?</h2>
        <p class="nwCtaLead">
          Available free for mobile and web. Start sharing real moments with your friends today.
        </p>
        <div class="nwHeroActions">
          <a
            class="nwBtnPrimary"
            href="https://apps.apple.com/app/nicerbook/id6818673106"
            target="_blank"
            rel="noopener noreferrer"
          >
            Download for iOS
          </a>
          <a
            class="nwBtnSecondary"
            href="https://play.google.com/store/apps/details?id=com.nicerbook.nicle"
            target="_blank"
            rel="noopener noreferrer"
          >
            Download for Android
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .nwPage {
    background: #090a10;
    color: #f1f3f9;
    min-height: 100vh;
  }

  .nwContainer {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Hero */
  .nwHero {
    padding: calc(var(--headerHeight) + 4rem) 0 4rem;
    background: radial-gradient(circle at 50% 20%, rgba(108, 92, 231, 0.22) 0%, transparent 60%),
                radial-gradient(circle at 80% 50%, rgba(0, 210, 255, 0.12) 0%, transparent 50%),
                #090a10;
    text-align: center;
  }

  .nwHeroContent {
    max-width: 780px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .nwLogoWrap {
    width: 96px;
    height: 96px;
    border-radius: 24px;
    background: #000;
    border: 2px solid rgba(108, 92, 231, 0.4);
    box-shadow: 0 12px 36px rgba(108, 92, 231, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .nwHeroLogo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .nwEyebrow {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #a29bfe;
    margin-bottom: 0.75rem;
  }

  .nwTitle {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.1;
    color: #ffffff;
    margin-bottom: 1.25rem;
    letter-spacing: -0.03em;
  }

  .nwAccent {
    background: linear-gradient(135deg, #a29bfe 0%, #6c5ce7 50%, #00d2ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .nwLead {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.6;
    color: #b2becd;
    margin-bottom: 2rem;
  }

  .nwHeroActions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .nwBtnPrimary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    border-radius: 14px;
    background: linear-gradient(135deg, #6c5ce7, #5b48e0);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(108, 92, 231, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .nwBtnPrimary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(108, 92, 231, 0.5);
  }

  .nwBtnSecondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .nwBtnSecondary:hover {
    background: rgba(255, 255, 255, 0.14);
    transform: translateY(-2px);
  }

  .nwHeroNote {
    font-size: 0.875rem;
    color: #7b889b;
    margin-top: 1.25rem;
  }

  /* Pillars */
  .nwPillarsSection {
    padding: 3rem 0;
    background: #0d0f17;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .nwPillarsGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .nwPillarCard {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
  }

  .nwPillarCheck {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: rgba(108, 92, 231, 0.2);
    color: #a29bfe;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    flex-shrink: 0;
  }

  .nwPillarTitle {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.35rem;
  }

  .nwPillarText {
    font-size: 0.875rem;
    color: #9aa7b9;
    line-height: 1.5;
    margin: 0;
  }

  /* Feature Sections */
  .nwFeaturesSection {
    padding: 5rem 0;
  }

  .nwSectionHead {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 4rem;
  }

  .nwSectionTitle {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .nwSectionLead {
    font-size: 1.125rem;
    color: #9aa7b9;
    line-height: 1.6;
  }

  .nwFeaturesList {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .nwFeatureCard {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.02) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    padding: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 2.5rem;
    align-items: center;
    transition: border-color 0.3s ease;
  }

  .nwFeatureCard:hover {
    border-color: rgba(108, 92, 231, 0.35);
  }

  .nwCardReverse {
    grid-template-columns: 280px 1fr;
  }

  .nwCardReverse .nwFeatureCopy {
    order: 2;
  }

  .nwCardReverse .nwFeatureGraphic {
    order: 1;
  }

  @media (max-width: 820px) {
    .nwFeatureCard,
    .nwCardReverse {
      grid-template-columns: 1fr;
    }
    .nwCardReverse .nwFeatureCopy {
      order: 1;
    }
    .nwCardReverse .nwFeatureGraphic {
      order: 2;
    }
  }

  .nwFeatureTag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #a29bfe;
    background: rgba(108, 92, 231, 0.15);
    padding: 0.3rem 0.75rem;
    border-radius: 8px;
    margin-bottom: 0.75rem;
  }

  .nwFeatureHeading {
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .nwFeatureLead {
    font-size: 1rem;
    color: #b2becd;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .nwFeatureBullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .nwFeatureBullets li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.9375rem;
    color: #d1d8e0;
  }

  .nwBulletDot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #6c5ce7;
    flex-shrink: 0;
  }

  .nwFeatureGraphic {
    height: 180px;
    border-radius: 18px;
    background: radial-gradient(circle at 50% 50%, rgba(108, 92, 231, 0.25) 0%, rgba(20, 16, 45, 0.6) 80%);
    border: 1px solid rgba(108, 92, 231, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nwGraphicBadge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.25rem;
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 100px;
  }

  .nwBadgeIcon {
    color: #a29bfe;
  }

  .nwBadgeText {
    font-size: 0.875rem;
    font-weight: 600;
    color: #ffffff;
  }

  /* CTA Band */
  .nwCtaBand {
    padding: 5rem 0;
    background: linear-gradient(180deg, #090a10 0%, #10121d 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    text-align: center;
  }

  .nwCtaInner {
    max-width: 680px;
  }

  .nwCtaTitle {
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .nwCtaLead {
    font-size: 1.125rem;
    color: #9aa7b9;
    margin-bottom: 2rem;
  }
</style>
