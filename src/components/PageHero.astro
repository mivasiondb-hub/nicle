---
interface Props {
  label: string;
  title: string;
  subtitle: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { label, title, subtitle, primaryCta, secondaryCta } = Astro.props;
---

<section class="pageHero" data-hero>
  <div class="pageHeroBg" aria-hidden="true">
    <div class="orb orbA" data-parallax="0.35"></div>
    <div class="orb orbB" data-parallax="0.2"></div>
    <div class="orb orbC" data-parallax="0.15"></div>
    <div class="gridOverlay"></div>
  </div>

  <div class="pageHeroInner" data-hero-content>
    <span class="pageBadge">
      <span class="badgePulse"></span>
      {label}
    </span>
    <h1 class="pageTitle" set:html={title} />
    <p class="pageSubtitle">{subtitle}</p>

    {(primaryCta || secondaryCta) && (
      <div class="pageActions">
        {primaryCta && (
          <a href={primaryCta.href} class="btnPrimary">
            {primaryCta.label}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        )}
        {secondaryCta && (
          <a href={secondaryCta.href} class="btnOutline">{secondaryCta.label}</a>
        )}
      </div>
    )}
  </div>

  <div class="pageCurve" aria-hidden="true"></div>
</section>

<style>
  .pageHero {
    position: relative;
    min-height: 58vh;
    display: flex;
    align-items: flex-end;
    padding: calc(var(--headerHeight) + 4rem) 2rem 6rem;
    background: linear-gradient(160deg, var(--colorHeroStart), var(--colorHeroMid) 55%, var(--colorHeroEnd));
    overflow: hidden;
  }

  .pageHeroBg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(50px);
    will-change: transform;
  }

  .orbA {
    top: -10%;
    right: -5%;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(237, 53, 66, 0.22), transparent 65%);
    animation: floatOrb 11s ease-in-out infinite alternate;
  }

  .orbB {
    bottom: 10%;
    left: -8%;
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(91, 124, 250, 0.2), transparent 65%);
    animation: floatOrb 9s ease-in-out infinite alternate-reverse;
  }

  .orbC {
    top: 40%;
    left: 45%;
    width: 260px;
    height: 260px;
    background: radial-gradient(circle, rgba(124, 92, 252, 0.16), transparent 65%);
  }

  @keyframes floatOrb {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(18px, -24px) scale(1.05); }
  }

  .gridOverlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black, transparent);
  }

  .pageHeroInner {
    position: relative;
    z-index: 2;
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
    will-change: transform, opacity;
  }

  .pageBadge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.95rem;
    margin-bottom: 1.25rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.88);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    animation: riseIn 0.8s var(--easeOutExpo) both;
  }

  .badgePulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--colorBrand);
    box-shadow: 0 0 12px var(--colorBrandGlow);
    animation: pulse 2.2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.55; transform: scale(0.85); }
  }

  .pageTitle {
    font-size: clamp(2.4rem, 6vw, 4.25rem);
    font-weight: 800;
    color: var(--colorWhite);
    margin-bottom: 1.15rem;
    animation: riseIn 0.9s var(--easeOutExpo) 0.1s both;
  }

  .pageTitle :global(.accent) {
    background: linear-gradient(120deg, #fff 10%, #ED3542 55%, #5b7cfa 100%);
    background-size: 200% auto;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: accentShiftHero 8s ease-in-out infinite;
  }

  @keyframes accentShiftHero {
    0%,
    100% {
      background-position: 0% center;
    }
    50% {
      background-position: 100% center;
    }
  }

  .pageSubtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: rgba(255, 255, 255, 0.7);
    max-width: 620px;
    line-height: 1.7;
    animation: riseIn 0.9s var(--easeOutExpo) 0.22s both;
  }

  .pageActions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
    animation: riseIn 0.9s var(--easeOutExpo) 0.35s both;
  }

  .pageCurve {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 64px;
    background: var(--colorWhite);
    clip-path: ellipse(70% 100% at 50% 100%);
    z-index: 3;
  }

  @keyframes riseIn {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .pageHero {
      min-height: 52vh;
      padding: calc(var(--headerHeight) + 3rem) 1.25rem 5rem;
    }
  }
</style>
