---
import { Image } from 'astro:assets';
import { products } from '../data/site';
import cardSocial from '../assets/images/card-social.png';
import cardAi from '../assets/images/card-ai.png';
import cardSecurity from '../assets/images/card-security.png';

const highlights = [
  {
    title: 'Social & creative platforms',
    text: 'Explore Mivasion, worldnicer, and Chatnicer — built for creators, communities, and positivity.',
    href: '/social',
    image: cardSocial,
    alt: 'Creators collaborating around phones and tablets in a bright modern workspace',
  },
  {
    title: 'Intelligence that creates',
    text: 'nicer ai plus delivers conversational AI, code, documents, and image generation at scale.',
    href: '/intelligence',
    image: cardAi,
    alt: 'Futuristic AI assistant interface glowing above a laptop with violet light trails',
  },
  {
    title: 'Security without compromise',
    text: 'nicerapp protects conversations with true end to end encryption and zero backdoors.',
    href: '/security',
    image: cardSecurity,
    alt: 'Hands holding a smartphone with a secure encrypted messaging glow',
  },
];
---

<section class="cardsSection">
  <div class="cardsIntro" data-scroll-reveal>
    <span class="sectionLabel">Ecosystem</span>
    <h2 class="sectionTitle">Products that redefine connection</h2>
    <p class="sectionLead">
      {products.length} platforms spanning social, messaging, creative AI, and intelligence —
      designed as one premium digital ecosystem.
    </p>
  </div>

  <div class="cardsGrid" data-scroll-reveal data-stagger>
    {highlights.map((card, index) => (
      <article
        class="featureCard"
        style={`--revealDelay: ${0.05 + index * 0.04}s`}
      >
        <a href={card.href} class="cardLink">
          <div class="cardVisual">
            <Image
              src={card.image}
              alt={card.alt}
              class="cardImage"
              widths={[400, 640, 800]}
              sizes="(max-width: 1024px) 100vw, 400px"
              quality={80}
              loading={index === 0 ? 'eager' : 'lazy'}
            />
            <div class="cardShade" aria-hidden="true"></div>
          </div>
          <div class="cardBody">
            <div>
              <h3 class="cardTitle">{card.title}</h3>
              <p class="cardText">{card.text}</p>
            </div>
            <span class="cardArrow" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path d="M4 14L14 4M14 4H6M14 4V12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </div>
        </a>
      </article>
    ))}
  </div>

  <div class="cardsCta" data-scroll-reveal>
    <a href="/products" class="btnPrimary">View all products</a>
  </div>
</section>

<style>
  .cardsSection {
    background: var(--colorSurface);
    padding: 1rem 2rem 5rem;
  }

  .cardsIntro {
    max-width: 640px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .cardsIntro .sectionLead {
    margin: 0 auto;
  }

  .cardsGrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.35rem;
    max-width: 1280px;
    margin: 0 auto;
  }

  .cardLink {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--colorWhite);
    border-radius: var(--radiusLg);
    overflow: hidden;
    border: 1px solid var(--colorBorder);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    transition:
      transform 0.5s var(--easeOutExpo),
      box-shadow 0.5s var(--easeOutQuart),
      border-color 0.35s ease;
  }

  .cardLink:hover {
    transform: translateY(-10px);
    box-shadow: 0 24px 50px rgba(237, 53, 66, 0.12);
    border-color: rgba(237, 53, 66, 0.18);
  }

  .cardVisual {
    position: relative;
    height: 240px;
    overflow: hidden;
    background: #10141f;
  }

  .cardImage {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.02);
    transition: transform 0.7s var(--easeOutExpo), filter 0.5s ease;
  }

  .cardShade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 45%,
      rgba(10, 10, 11, 0.18) 100%
    );
    pointer-events: none;
    opacity: 0.65;
    transition: opacity 0.4s ease;
  }

  .cardLink:hover .cardImage {
    transform: scale(1.1);
    filter: saturate(1.08) contrast(1.04);
  }

  .cardLink:hover .cardShade {
    opacity: 0.35;
  }

  .cardBody {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 1.5rem 1.75rem;
    flex: 1;
  }

  .cardTitle {
    font-size: 1.15rem;
    margin-bottom: 0.45rem;
  }

  .cardText {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--colorTextMuted);
  }

  .cardArrow {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--colorBrand);
    background: var(--colorBrandSoft);
    border-radius: 50%;
    transition: transform 0.35s var(--easeOutExpo), background 0.3s ease;
  }

  .cardLink:hover .cardArrow {
    transform: translate(2px, -2px);
    background: rgba(237, 53, 66, 0.18);
  }

  .cardsCta {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }

  @media (max-width: 1024px) {
    .cardsGrid {
      grid-template-columns: 1fr;
      max-width: 520px;
    }

    .cardVisual {
      height: 220px;
    }
  }
</style>
