---
import { Image } from 'astro:assets';
import { products } from '../data/site';
import nicerwaveLogo from '../assets/images/nicerwave-fit.jpeg';
import nicerAiLogo from '../assets/images/nicer-ai-plus-fit.jpeg';
import nicerappLogo from '../assets/images/nicerapp-fit.jpeg';

// Each card shows a cropped screen of the product itself, drawn in code, instead of a stock photo.
const highlights = [
  {
    kind: 'wave',
    eyebrow: 'Social operating system',
    title: 'nicerwave',
    text: 'A creator platform where every voice is heard, even with no followers. Grow your NicerWorth and make the app your own.',
    href: '/nicerwave',
    logo: nicerwaveLogo,
    accent: '#3aa0ff',
  },
  {
    kind: 'ai',
    eyebrow: 'Our own AI',
    title: 'Nicer AI & nicer ai plus',
    text: 'Our own family of AI models, and the assistant built on them: chat, code, documents, images and music.',
    href: '/nicer-ai-plus',
    logo: nicerAiLogo,
    accent: '#8b6cff',
  },
  {
    kind: 'voice',
    eyebrow: 'AI voice messaging',
    title: 'nicerapp',
    text: 'Say “Hey Nicer” to message and call hands-free, even on 2G and in your own language.',
    href: '/nicerapp',
    logo: nicerappLogo,
    accent: '#ff4d6d',
  },
];

// Static waveform shapes: a voice note on nicerwave, live dictation on nicerapp.
const noteBars = [0.3, 0.55, 0.8, 0.45, 0.95, 0.6, 0.35, 0.7, 1, 0.5, 0.65, 0.3, 0.85, 0.55, 0.4, 0.75, 0.5, 0.3, 0.6, 0.45, 0.25, 0.4];
const liveBars = [0.35, 0.6, 0.9, 0.55, 1, 0.7, 0.4, 0.85, 0.5];
---

<section class="cardsSection">
  <div class="cardsIntro" data-scroll-reveal>
    <span class="sectionLabel">Ecosystem</span>
    <h2 class="sectionTitle">Products that redefine connection</h2>
    <p class="sectionLead">
      {products.length} AI-powered products for positive human connection, together called the
      Nicer ecosystem.
    </p>
  </div>

  <div class="cardsGrid" data-scroll-reveal data-stagger>
    {highlights.map((card, index) => (
      <article class="featureCard" style={`--revealDelay: ${0.05 + index * 0.04}s; --cardAccent: ${card.accent}`}>
        <a href={card.href} class="cardLink">
          <div class:list={['cardVisual', `scene-${card.kind}`]} aria-hidden="true">

            {/* ---------- nicerwave: a post in the For you feed ---------- */}
            {card.kind === 'wave' && (
              <div class="device">
                <div class="screen">
                  <div class="statusBar">
                    <span>9:41</span>
                    <span class="statusIcons">
                      <svg width="15" height="10" viewBox="0 0 15 10" fill="currentColor"><rect x="0" y="7" width="3" height="3" rx="0.6" /><rect x="4" y="5" width="3" height="5" rx="0.6" /><rect x="8" y="2.5" width="3" height="7.5" rx="0.6" /><rect x="12" y="0" width="3" height="10" rx="0.6" /></svg>
                      <span class="battery"><i style="width: 78%"></i></span>
                    </span>
                  </div>

                  <div class="waveTop">
                    <div class="tabs">
                      <span class="tab isActive">For you</span>
                      <span class="tab">Following</span>
                    </div>
                    <span class="worth">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8M15 7h6v6" /></svg>
                      1,240
                    </span>
                  </div>

                  <div class="post">
                    <div class="postHead">
                      <span class="avatar" style="background: #2f5fd0">AO</span>
                      <div class="postWho">
                        <span class="postName">Adaeze Okafor</span>
                        <span class="postHandle">@adaeze.makes · 2h</span>
                      </div>
                    </div>
                    <p class="postText">First beat I’ve ever posted. Zero followers, and this morning 12,400 people had listened.</p>

                    <div class="voiceNote">
                      <span class="playBtn">
                        <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l13-7.5z" /></svg>
                      </span>
                      <span class="noteBars">
                        {noteBars.map((h, i) => <i class={i < 8 ? 'played' : ''} style={`--h: ${h}`}></i>)}
                      </span>
                      <span class="noteTime">0:42</span>
                    </div>

                    <div class="postActions">
                      <span>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z" /></svg>
                        2.1K
                      </span>
                      <span>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.4L3 21l2-5.4A8.4 8.4 0 1 1 21 11.5z" /></svg>
                        318
                      </span>
                      <span>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 2l4 4-4 4" /><path d="M3 11V9a3 3 0 0 1 3-3h15M7 22l-4-4 4-4" /><path d="M21 13v2a3 3 0 0 1-3 3H3" /></svg>
                        96
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {/* ---------- Nicer AI: the nicer ai plus desktop window ---------- */}
            {card.kind === 'ai' && (
              <div class="appWindow">
                <div class="windowBar">
                  <span class="lights"><i></i><i></i><i></i></span>
                  <span class="windowTitle">nicer ai plus</span>
                </div>
                <div class="chatHead">
                  <span class="modelPick">
                    Miva 4.5
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
                  </span>
                  <span class="chatMeta">New chat</span>
                </div>
                <div class="chatBody">
                  <p class="msgUser">Write a song about Lagos at night</p>
                  <div class="msgAi">
                    <span class="aiName">
                      <Image src={nicerAiLogo} alt="" width={32} height={32} formats={['webp']} quality={75} loading="lazy" />
                      Miva 4.5
                    </span>
                    <p class="songTitle">Third Mainland Lights</p>
                    <p class="songLabel">Verse 1</p>
                    <p class="songLine">Danfo horns go quiet on the bridge,</p>
                    <p class="songLine">the lagoon keeps every light the Island throws,<span class="caret"></span></p>
                  </div>
                </div>
              </div>
            )}

            {/* ---------- nicerapp: dictating a message in Pidgin ---------- */}
            {card.kind === 'voice' && (
              <div class="device">
                <div class="screen">
                  <div class="statusBar">
                    <span>9:41</span>
                    <span class="statusIcons">
                      <span class="netTag">2G</span>
                      <svg width="15" height="10" viewBox="0 0 15 10" fill="currentColor"><rect x="0" y="7" width="3" height="3" rx="0.6" /><rect x="4" y="5" width="3" height="5" rx="0.6" /><rect x="8" y="2.5" width="3" height="7.5" rx="0.6" opacity="0.35" /><rect x="12" y="0" width="3" height="10" rx="0.6" opacity="0.35" /></svg>
                      <span class="battery"><i style="width: 46%"></i></span>
                    </span>
                  </div>

                  <div class="convHead">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
                    <span class="avatar small" style="background: #b4446a">M</span>
                    <div class="convWho">
                      <span class="convName">Mum</span>
                      <span class="convSub">Replies in Pidgin</span>
                    </div>
                  </div>

                  <div class="thread">
                    <p class="bubbleIn">Where you dey? Food don ready</p>
                    <p class="bubbleOut">I dey come, I go reach in 20 minutes.</p>
                    <span class="sentMeta">
                      Sent by voice · 9:41
                      <svg width="13" height="9" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 5.5L4.5 9 11 1.5M7.5 8L9 9.5 16.5 1.5" /></svg>
                    </span>
                  </div>

                  <div class="listenBar">
                    <span class="micDot">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="12" rx="3" /><path d="M5 10a7 7 0 0 0 14 0M12 17v4" /></svg>
                    </span>
                    <div class="listenText">
                      <span class="listenLabel">Listening</span>
                      <span class="transcript">“Hey Nicer, text Mum I’m on my way”</span>
                    </div>
                    <span class="liveBars">
                      {liveBars.map((h, i) => <i style={`--h: ${h}; --b: ${i}`}></i>)}
                    </span>
                  </div>
                </div>
              </div>
            )}
          </div>

          <div class="cardBody">
            <div>
              <span class="cardEyebrow">
                <span class="eyebrowLogo">
                  <Image src={card.logo} alt="" width={48} height={48} formats={['avif', 'webp']} quality={80} loading="lazy" />
                </span>
                {card.eyebrow}
              </span>
              <h3 class="cardTitle">{card.title}</h3>
              <p class="cardText">{card.text}</p>
            </div>
            <span class="cardArrow" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path d="M4 14L14 4M14 4H6M14 4V12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </div>
        </a>
      </article>
    ))}
  </div>

  <div class="cardsCta" data-scroll-reveal>
    <a href="/products" class="btnPrimary">View all products</a>
  </div>
</section>

<style>
  .cardsSection {
    background: var(--colorSurface);
    padding: 1rem 2rem 5rem;
  }

  .cardsIntro {
    max-width: 640px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .cardsIntro .sectionLead {
    margin: 0 auto;
  }

  .cardsGrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.35rem;
    max-width: 1280px;
    margin: 0 auto;
  }

  /* ---------- Card shell ---------- */
  .cardLink {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--colorCard);
    border-radius: var(--radiusLg);
    overflow: hidden;
    border: 1px solid var(--colorBorder);
    isolation: isolate;
    transition:
      transform 0.5s var(--easeOutExpo),
      border-color 0.35s ease,
      background 0.35s ease;
  }

  .cardLink:hover {
    transform: translateY(-4px);
    border-color: var(--colorBorderStrong);
    background: var(--colorCardHover);
  }

  .cardLink:focus-visible {
    outline: 2px solid var(--cardAccent);
    outline-offset: 3px;
  }

  /* ---------- Scene canvas ---------- */
  .cardVisual {
    position: relative;
    height: 316px;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 26px;
    border-bottom: 1px solid var(--colorBorder);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--cardAccent) 9%, #0d0f15) 0%, #0b0c11 100%);
    /* Every scene in this canvas is product UI, so it uses the platform font like the apps do. */
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
    color: #e9eaee;
    -webkit-font-smoothing: antialiased;
  }

  /* Fades the cropped bottom of each screen into the card. */
  .cardVisual::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 34px;
    background: linear-gradient(180deg, transparent, #0b0c11);
    pointer-events: none;
    z-index: 2;
  }

  .cardVisual p {
    margin: 0;
  }

  /* ---------- Shared phone frame ---------- */
  .device {
    position: relative;
    width: 248px;
    flex-shrink: 0;
    padding: 6px 6px 0;
    border-radius: 36px 36px 0 0;
    background: #1b1d23;
    border: 1px solid #30333b;
    border-bottom: 0;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 30px 60px -20px rgba(0, 0, 0, 0.7);
    transition: transform 0.6s var(--easeOutExpo);
  }

  .cardLink:hover .device,
  .cardLink:hover .appWindow {
    transform: translateY(-6px);
  }

  .screen {
    height: 300px;
    padding: 0 14px;
    border-radius: 30px 30px 0 0;
    background: #0a0b0f;
    overflow: hidden;
  }

  .statusBar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 34px;
    padding: 0 6px;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .statusIcons {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .netTag {
    font-size: 9.5px;
    font-weight: 700;
  }

  .battery {
    position: relative;
    width: 21px;
    height: 10px;
    padding: 1.5px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 3px;
  }

  .battery i {
    display: block;
    height: 100%;
    border-radius: 1px;
    background: #fff;
  }

  .avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-size: 10.5px;
    font-weight: 700;
    color: #fff;
  }

  .avatar.small {
    width: 26px;
    height: 26px;
  }

  /* ---------- nicerwave ---------- */
  .waveTop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 0 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .tabs {
    display: flex;
    gap: 14px;
  }

  .tab {
    padding: 6px 0 8px;
    font-size: 12px;
    font-weight: 600;
    color: #7d818d;
  }

  .tab.isActive {
    color: #fff;
    box-shadow: inset 0 -2px 0 #3aa0ff;
  }

  .worth {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 4px;
    font-size: 11px;
    font-weight: 600;
    color: #6fcf97;
    font-variant-numeric: tabular-nums;
  }

  .post {
    padding-top: 12px;
  }

  .postHead {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .postWho {
    display: grid;
    line-height: 1.25;
  }

  .postName {
    font-size: 12px;
    font-weight: 600;
  }

  .postHandle {
    font-size: 10.5px;
    color: #7d818d;
  }

  .cardVisual .postText {
    margin: 9px 0 10px;
    font-size: 12px;
    line-height: 1.45;
    color: #d9dbe1;
  }

  .voiceNote {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 12px;
    background: #15171d;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .playBtn {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    padding-left: 1px;
    border-radius: 50%;
    background: #fff;
    color: #0a0b0f;
  }

  .noteBars {
    display: flex;
    align-items: center;
    gap: 2px;
    flex: 1;
    height: 20px;
  }

  .noteBars i {
    flex: 1;
    height: calc(var(--h) * 100%);
    border-radius: 2px;
    background: #4a4e59;
  }

  .noteBars i.played {
    background: #3aa0ff;
  }

  .noteTime {
    font-size: 10px;
    color: #7d818d;
    font-variant-numeric: tabular-nums;
  }

  .postActions {
    display: flex;
    gap: 18px;
    margin-top: 11px;
    font-size: 10.5px;
    color: #9a9ea9;
    font-variant-numeric: tabular-nums;
  }

  .postActions span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  /* ---------- Nicer AI ---------- */
  .appWindow {
    width: min(340px, 86%);
    flex-shrink: 0;
    border-radius: 12px 12px 0 0;
    background: #101116;
    border: 1px solid #2c2f37;
    border-bottom: 0;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.7);
    overflow: hidden;
    transition: transform 0.6s var(--easeOutExpo);
  }

  .windowBar {
    position: relative;
    display: flex;
    align-items: center;
    height: 28px;
    padding: 0 10px;
    background: #17181e;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .lights {
    display: inline-flex;
    gap: 6px;
  }

  .lights i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #3a3d46;
  }

  .windowTitle {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 10.5px;
    font-weight: 500;
    color: #7d818d;
  }

  .chatHead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .modelPick {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 8px;
    border-radius: 7px;
    font-size: 11px;
    font-weight: 600;
    background: #1b1c23;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .chatMeta {
    font-size: 10.5px;
    color: #6b6f7a;
  }

  .chatBody {
    display: grid;
    gap: 12px;
    padding: 14px 14px 30px;
  }

  .cardVisual .msgUser {
    justify-self: end;
    max-width: 80%;
    padding: 7px 11px;
    border-radius: 14px;
    font-size: 11.5px;
    line-height: 1.4;
    background: #24262e;
  }

  .msgAi {
    display: grid;
    gap: 3px;
  }

  .aiName {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 5px;
    font-size: 10.5px;
    font-weight: 600;
    color: #a5a9b4;
  }

  .aiName img {
    width: 16px;
    height: 16px;
    border-radius: 4px;
  }

  .cardVisual .songTitle {
    font-size: 12px;
    font-weight: 700;
  }

  .cardVisual .songLabel {
    margin-top: 4px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #7d818d;
  }

  .cardVisual .songLine {
    font-size: 11.5px;
    line-height: 1.5;
    color: #d9dbe1;
  }

  .caret {
    display: inline-block;
    width: 6px;
    height: 12px;
    margin-left: 2px;
    vertical-align: -2px;
    background: #8b6cff;
    animation: caretBlink 1s steps(1) infinite;
  }

  /* ---------- nicerapp ---------- */
  .convHead {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0 10px;
    color: #9a9ea9;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .convWho {
    display: grid;
    line-height: 1.25;
  }

  .convName {
    font-size: 12px;
    font-weight: 600;
    color: #fff;
  }

  .convSub {
    font-size: 10px;
    color: #7d818d;
  }

  .thread {
    display: grid;
    gap: 6px;
    padding: 10px 0 8px;
  }

  .cardVisual .bubbleIn,
  .cardVisual .bubbleOut {
    max-width: 82%;
    padding: 7px 11px;
    border-radius: 16px;
    font-size: 11.5px;
    line-height: 1.4;
  }

  .bubbleIn {
    justify-self: start;
    background: #1d1f26;
    border-bottom-left-radius: 5px;
  }

  .bubbleOut {
    justify-self: end;
    background: #d8395a;
    color: #fff;
    border-bottom-right-radius: 5px;
  }

  .sentMeta {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 9.5px;
    color: #7d818d;
  }

  .sentMeta svg {
    color: #5aa9ff;
  }

  .listenBar {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 9px 10px;
    border-radius: 16px;
    background: #15171d;
    border: 1px solid rgba(255, 255, 255, 0.07);
  }

  .micDot {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #ff4d6d;
    color: #fff;
  }

  .listenText {
    display: grid;
    min-width: 0;
    line-height: 1.3;
  }

  .listenLabel {
    font-size: 9.5px;
    font-weight: 600;
    color: #ff7a93;
  }

  .transcript {
    font-size: 10.5px;
    color: #d9dbe1;
  }

  .liveBars {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 18px;
    margin-left: auto;
    flex-shrink: 0;
  }

  .liveBars i {
    width: 2px;
    height: 100%;
    border-radius: 1px;
    background: #ff7a93;
    transform: scaleY(var(--h));
    animation: liveBar 1.1s ease-in-out infinite;
    animation-delay: calc(var(--b) * -0.09s);
  }

  /* ---------- Card text ---------- */
  .cardBody {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.4rem 1.5rem 1.65rem;
    flex: 1;
  }

  .cardEyebrow {
    display: flex;
