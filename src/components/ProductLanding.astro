---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PageHero from './PageHero.astro';
import type { ProductSeo } from '../data/productSeo';
import { productSeo } from '../data/productSeo';

interface Props {
  product: ProductSeo;
  logo: ImageMetadata;
}

const { product, logo } = Astro.props;

const related = product.related
  .map((key) => {
    if (key === 'social') return { name: 'Social platforms', path: '/social' };
    if (key === 'intelligence') return { name: 'Intelligence', path: '/intelligence' };
    if (key === 'security') return { name: 'Security', path: '/security' };
    const match = productSeo.find((p) => p.id === key || p.slug === key);
    return match ? { name: match.name, path: match.path } : null;
  })
  .filter((item): item is { name: string; path: string } => !!item);
---

<PageHero
  label={product.name}
  title={product.heroTitle}
  subtitle={product.heroSubtitle}
  primaryCta={{ label: 'View all products', href: '/products' }}
  secondaryCta={{ label: 'About Nicle', href: '/about' }}
/>

<section class="plSection">
  <div class="plLayout">
    <div class="plVisual" data-scroll-reveal="left">
      <Image
        src={logo}
        alt={`${product.name} logo`}
        class="plImage"
        widths={[320, 480, 640]}
        sizes="(max-width: 900px) 180px, 220px"
        quality={95}
      />
    </div>
    <div class="plCopy" data-scroll-reveal="right">
      <span class="sectionLabel">{product.sectionLabel}</span>
      <h2 class="sectionTitle">{product.sectionTitle}</h2>
      {product.body.map((paragraph) => <p>{paragraph}</p>)}
      <ul class="plFeatures">
        {product.features.map((feature) => (
          <li>
            <span class="dot" style={`background: ${product.accent}`} aria-hidden="true"></span>
            {feature}
          </li>
        ))}
      </ul>
      <div class="plActions">
        <a href="/products" class="btnPrimary">Back to products</a>
        <a href="/about" class="btnGhost">Why Nicle builds this</a>
      </div>
    </div>
  </div>
</section>

<section class="plWhy">
  <div class="plWhyInner" data-scroll-reveal>
    <span class="sectionLabel">Why {product.name}</span>
    <h2 class="sectionTitle">Built for people who want better digital tools</h2>
    <div class="plGrid">
      {product.why.map((item) => (
        <article>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="plFaq" data-scroll-reveal>
  <div class="plFaqInner">
    <span class="sectionLabel">FAQ</span>
    <h2 class="sectionTitle">Common questions about {product.name}</h2>
    <div class="plFaqList">
      <details open>
        <summary>What is {product.name}?</summary>
        <p>{product.description}</p>
      </details>
      <details>
        <summary>Who builds {product.name}?</summary>
        <p>
          {product.name} is built by Nicle Inc, a subsidiary of All Things Web Technology Inc., as
          part of the Nicer Ecosystem.
        </p>
      </details>
      <details>
        <summary>What features does {product.name} include?</summary>
        <p>{product.features.join(', ')}.</p>
      </details>
    </div>
  </div>
</section>

{related.length > 0 && (
  <section class="plRelated" data-scroll-reveal>
    <div class="plRelatedInner">
      <span class="sectionLabel">Explore more</span>
      <h2 class="sectionTitle">Related products &amp; services</h2>
      <div class="plRelatedRow">
        {related.map((item) => (
          <a href={item.path} class="plRelatedChip">{item.name}</a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .plSection {
    padding: 4rem 2rem 5rem;
    background: var(--colorWhite);
  }

  .plLayout {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 3rem;
    align-items: center;
  }

  .plVisual {
    width: 220px;
    height: 220px;
    display: block;
    border-radius: 50%;
    overflow: hidden;
    background: #000;
    box-shadow:
      0 16px 34px rgba(10, 10, 11, 0.16),
      0 0 0 1px rgba(10, 10, 11, 0.06);
  }

  .plImage {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    max-width: none !important;
    display: block;
  }

  .plCopy p {
    color: var(--colorTextMuted);
    margin-bottom: 1rem;
    font-size: 1.05rem;
  }

  .plFeatures {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem 1rem;
    margin: 1.5rem 0 1.75rem;
  }

  .plFeatures li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .plActions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .plWhy,
  .plFaq,
  .plRelated {
    padding: 4.5rem 2rem;
  }

  .plWhy {
    background: var(--colorSurface);
  }

  .plFaq,
  .plRelated {
    background: var(--colorWhite);
  }

  .plWhyInner,
  .plFaqInner,
  .plRelatedInner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .plWhyInner .sectionTitle,
  .plFaqInner .sectionTitle,
  .plRelatedInner .sectionTitle {
    margin-bottom: 2rem;
  }

  .plGrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .plGrid article {
    padding: 1.75rem;
    background: var(--colorWhite);
    border: 1px solid var(--colorBorder);
    border-radius: var(--radiusMd);
  }

  .plGrid h3 {
    font-size: 1.15rem;
    margin-bottom: 0.65rem;
  }

  .plGrid p {
    color: var(--colorTextMuted);
    font-size: 0.95rem;
  }

  .plFaqList {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-width: 760px;
  }

  .plFaqList details {
    border: 1px solid var(--colorBorder);
    border-radius: var(--radiusMd);
    background: var(--colorSurface);
    padding: 1rem 1.15rem;
  }

  .plFaqList summary {
    cursor: pointer;
    font-weight: 700;
    font-family: var(--fontDisplay);
  }

  .plFaqList p {
    margin-top: 0.75rem;
    color: var(--colorTextMuted);
  }

  .plRelatedRow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .plRelatedChip {
    padding: 0.7rem 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--colorBorder);
    background: var(--colorSurface);
    font-weight: 600;
    transition: transform 0.3s var(--easeOutExpo), border-color 0.25s ease, color 0.25s ease;
  }

  .plRelatedChip:hover {
    transform: translateY(-2px);
    color: var(--colorBrand);
    border-color: rgba(237, 53, 66, 0.28);
  }

  @media (max-width: 900px) {
    .plLayout,
    .plGrid,
    .plFeatures {
      grid-template-columns: 1fr;
    }

    .plVisual {
      margin: 0 auto;
    }

    .plActions {
      justify-content: center;
    }
  }
</style>
