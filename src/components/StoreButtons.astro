---
// Download buttons for nicerapp: App Store, Google Play, and the web app for Windows and other computers.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const stores = [
  {
    href: 'https://apps.apple.com/app/id6794080010',
    small: 'Download on the',
    big: 'App Store',
    label: 'Download nicerapp on the App Store for iPhone and iPad',
    icon: 'M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 1.01-2.87-1 .04-2.17.67-2.86 1.47-.57.65-1.07 1.72-.94 2.76 1.12.09 2.18-.61 2.79-1.36z',
  },
  {
    href: 'https://play.google.com/store/apps/details?id=com.nicerapps.nicle',
    small: 'Get it on',
    big: 'Google Play',
    label: 'Get nicerapp on Google Play for Android',
    icon: 'M3.61 1.81 13.79 12 3.61 22.19a2 2 0 0 1-.61-.93V2.74c.16-.36.38-.68.61-.93zm11.6 11.61 2.25 2.25-11.45 6.47 9.2-8.72zm2.25-2.25-2.25 2.25-9.2-8.72 11.45 6.47zm1.42 1.42 2.84 1.6c.78.44.78 1.16 0 1.6l-2.84 1.6-2.03-2.4 2.03-2.4z',
  },
  {
    href: 'https://nicerapp.cloud/',
    small: 'Use on',
    big: 'Windows & web',
    label: 'Use nicerapp on Windows or any computer in your browser',
    icon: 'M3 5.48 10.36 4.5v7.06H3zm8.26-1.1L21 3v8.56h-9.74zM3 12.44h7.36v7.08L3 18.52zm8.26 0H21V21l-9.74-1.36z',
  },
];
---

<div class:list={['storeButtons', className]}>
  {stores.map((s) => (
    <a class="storeBtn" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
      <svg class="storeIcon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d={s.icon} />
      </svg>
      <span class="storeText">
        <span class="storeSmall">{s.small}</span>
        <span class="storeBig">{s.big}</span>
      </span>
    </a>
  ))}
</div>

<style>
  .storeButtons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .storeBtn {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 172px;
    padding: 0.6rem 1.15rem 0.6rem 0.95rem;
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.03));
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #ffffff;
    text-decoration: none;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.35);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
  }

  .storeBtn:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 93, 105, 0.6);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.13), rgba(255, 255, 255, 0.05));
    box-shadow: 0 14px 34px rgba(237, 53, 66, 0.25);
  }

  .storeBtn:focus-visible {
    outline: 2px solid var(--colorBrandText, #ff5d69);
    outline-offset: 3px;
  }

  .storeIcon {
    flex-shrink: 0;
  }

  .storeText {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    text-align: left;
  }

  .storeSmall {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.72);
  }

  .storeBig {
    font-family: var(--fontDisplay);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  @media (max-width: 480px) {
    .storeButtons {
      flex-direction: column;
      align-items: stretch;
    }

    .storeBtn {
      justify-content: center;
    }
  }
</style>
