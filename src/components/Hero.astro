      <animate attributeName="d" dur="11s" repeatCount="indefinite" calcMode="spline" keySplines="0.45 0 0.55 1;0.45 0 0.55 1" values="M0,82 C120,62 200,112 330,96 C460,80 520,32 660,42 C800,52 860,106 1000,100 C1140,94 1240,40 1440,70;M0,91 C120,53 200,121 330,87 C460,89 520,23 660,51 C800,43 860,115 1000,91 C1140,103 1240,31 1440,79;M0,82 C120,62 200,112 330,96 C460,80 520,32 660,42 C800,52 860,106 1000,100 C1140,94 1240,40 1440,70" />
    </path>
    <circle class="poolBead b1" cx="420" cy="58" r="6" fill="#D52E40" />
