---
import { helpProducts } from '../data/helpData';
import { leadership } from '../data/leadership';
import { products } from '../data/site';

const searchIndex = [
  ...products.map((p) => ({
    type: 'Product',
    title: p.name,
    subtitle: p.tagline,
    path: p.id === 'niceraiplus' ? '/nicer-ai-plus' : `/${p.id}`,
  })),
  ...leadership.map((l) => ({
    type: 'Team Member',
    title: l.name,
    subtitle: l.role,
    path: `/team/${l.slug}`,
  })),
  ...helpProducts.flatMap((p) =>
    p.articles.map((a) => ({
      type: 'Help Guide',
      title: a.title,
      subtitle: `${p.name} · ${a.category}`,
      path: `/help/${p.id}/${a.id}`,
    }))
  ),
  { type: 'Page', title: 'Help Center', subtitle: 'Support portals & product help guides', path: '/help' },
  { type: 'Page', title: 'About Nicle', subtitle: 'Our mission, vision, and corporate history', path: '/about' },
  { type: 'Page', title: 'Founders', subtitle: 'Meet Mr. Highness HC & Mr. Justice Friday', path: '/about/founders' },
  { type: 'Page', title: 'Careers', subtitle: 'Join Nicle Inc & build next-gen human connections', path: '/careers' },
  { type: 'Page', title: 'Contact Us', subtitle: 'General inquiries and support desk email links', path: '/contact' },
];
---

