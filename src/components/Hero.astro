  </div>

  <div class="heroContent" data-hero-content>
    <div class="heroBadge">
      <span class="badgeDot"></span>
      Nicle Inc &middot; Conglomerate
    </div>

    <h1 class="heroTitle">
      <span class="brandWord">
        <span class="brandWordGlow" aria-hidden="true"></span>
        <span class="brandWordAurora">Nicle</span>
      </span>
      <span class="titleSeparator"> — </span>
      <span class="titleLine">Building the future of <span class="titleAccent">human connection</span></span>
    </h1>

    <p class="heroSubtitle">
      AI voice messaging, a social platform where every voice is heard &amp; our own AI.
    </p>

    <!-- Google-Style Search Bar -->
    <div class="heroSearchContainer">
      <div class="heroSearchBox">
        <svg class="heroSearchIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--colorTextMuted)" stroke-width="2.5">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="text" 
          id="heroSearchInput" 
          placeholder="Search products, team, help guides..." 
          autocomplete="off"
        />
        <button id="heroSearchClear" class="heroSearchClearBtn" aria-label="Clear search" style="display: none;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--colorTextMuted)" stroke-width="2.5">
