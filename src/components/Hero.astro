    <circle class="poolBead b3" cx="1190" cy="30" r="5" fill="#D52E40" />
  </svg>

</section>

<script define:vars={{ searchIndex }}>
  const input = document.getElementById('heroSearchInput');
  const clearBtn = document.getElementById('heroSearchClear');
  const panel = document.getElementById('heroSearchSuggestions');
  const list = document.getElementById('heroSuggestionsList');

  // Apply inline styles directly to the panel so Astro scoping never blocks it
  if (panel) {
    panel.style.cssText = `
      display: none;
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      right: 0;
      background: var(--colorPanel);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 18px;
      box-shadow: 0 16px 40px rgba(0,0,0,0.28);
      overflow: hidden;
      text-align: left;
      z-index: 99999;
    `;
  }

  const badgeColors = {
    'product':     { bg: 'rgba(138, 180, 248, 0.14)', color: '#8ab4f8' },
    'team-member': { bg: 'rgba(242, 139, 130, 0.14)', color: '#f28b82' },
    'help-guide':  { bg: 'rgba(129, 201, 149, 0.14)', color: '#81c995' },
    'page':        { bg: 'rgba(255, 255, 255, 0.08)', color: 'var(--colorTextMuted)' },
  };

  function highlightQuery(text, query) {
    if (!query) return text;
    const idx = text.toLowerCase().indexOf(query.toLowerCase());
    if (idx === -1) return text;
    const before = text.substring(0, idx);
    const match = text.substring(idx, idx + query.length);
    const after = text.substring(idx + query.length);
    return `${before}<strong style="color:#8ab4f8;font-weight:700;">${match}</strong>${after}`;
  }

  if (input) {
    input.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();

      if (query.length > 0) {
        clearBtn.style.display = 'flex';
      } else {
        clearBtn.style.display = 'none';
      }

      if (query === '') {
        panel.style.display = 'none';
        return;
      }

      const results = searchIndex.filter((item) => 
        item.title.toLowerCase().includes(query) ||
        item.subtitle.toLowerCase().includes(query) ||
        item.type.toLowerCase().includes(query)
      ).slice(0, 5);

      if (results.length > 0) {
        panel.style.display = 'block';
        list.innerHTML = results.map(item => {
          const highlightedTitle = highlightQuery(item.title, e.target.value.trim());
          const badgeClass = item.type.toLowerCase().replace(' ', '-');
          const badge = badgeColors[badgeClass] || badgeColors['page'];
          return `
            <a href="${item.path}" style="
              display:flex;
              align-items:center;
              justify-content:space-between;
              padding:0.7rem 1.15rem;
              color:var(--colorInk);
              text-decoration:none;
              border-bottom:1px solid rgba(255, 255, 255, 0.08);
              background:transparent;
              transition: background 0.15s;
            " onmouseover="this.style.background='rgba(255, 255, 255, 0.06)'" onmouseout="this.style.background='transparent'">
              <div style="display:flex;align-items:center;gap:0.85rem;min-width:0;flex-grow:1;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--colorTextMuted)" stroke-width="2" style="flex-shrink:0;">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <div style="display:flex;flex-direction:column;min-width:0;">
                  <span style="font-size:0.925rem;font-weight:500;color:var(--colorInk);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${highlightedTitle}</span>
                  <span style="font-size:0.78rem;color:var(--colorTextMuted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${item.subtitle}</span>
                </div>
              </div>
              <span style="
                font-size:0.68rem;
                font-weight:700;
                text-transform:uppercase;
                letter-spacing:0.04em;
                padding:0.22rem 0.6rem;
                border-radius:12px;
                flex-shrink:0;
                margin-left:0.5rem;
                background:${badge.bg};
                color:${badge.color};
              ">${item.type}</span>
            </a>
          `;
        }).join('') + `
          <div style="padding:0.45rem 1.15rem;background:var(--colorSurface);border-top:1px solid rgba(255, 255, 255, 0.08);text-align:right;font-size:0.72rem;color:var(--colorTextMuted);">
            Click a prediction to jump to page
          </div>
        `;
      } else {
        panel.style.display = 'block';
        list.innerHTML = `
          <div style="display:flex;align-items:center;justify-content:center;gap:0.6rem;padding:1.25rem 1rem;color:var(--colorTextMuted);font-size:0.88rem;background:var(--colorPanel);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--colorTextMuted)" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span>No results found for "${e.target.value}"</span>
          </div>
        `;
      }
    });

    clearBtn.addEventListener('click', () => {
      input.value = '';
      clearBtn.style.display = 'none';
      panel.style.display = 'none';
      input.focus();
    });

    document.addEventListener('click', (e) => {
      if (!input.contains(e.target) && !panel.contains(e.target)) {
        panel.style.display = 'none';
      }
    });
  }
</script>

<style>
  /* Compact Hero Section with Unclipped Overlay Container */
  .heroSection {
    position: relative;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: auto;
    padding: calc(var(--headerHeight) + clamp(6rem, 12vw, 9.5rem)) 1.25rem clamp(7rem, 11vw, 10rem);
    background:
      radial-gradient(ellipse 70% 60% at 50% 55%, #ffffff 0%, #f6f6f8 60%, #ececef 100%);
    overflow: visible !important;
  }

  .heroBg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  /* The white hero has no colour orbs or grid: the black liquid carries it. */
  .heroOrb,
  .heroGrid {
    display: none;
  }

  .liquidTop {
    position: absolute;
    top: var(--headerHeight);
    left: 0;
    width: 100%;
    height: clamp(120px, 19vw, 270px);
    overflow: visible;
  }

  .liquidPool {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: clamp(70px, 10vw, 150px);
    z-index: 2;
    pointer-events: none;
    overflow: visible;
  }

  .liquidDrip {
    transform-box: fill-box;
    transform-origin: 50% 0;
    animation: liquidStretch 4.2s ease-in-out infinite;
    animation-delay: var(--d);
  }

  .liquidSpark {
    opacity: 0.55;
  }

  .liquidDrop {
    transform-box: fill-box;
    opacity: 0;
    animation: liquidFall 4.2s ease-in infinite;
    animation-delay: var(--d);
  }

  .poolBead {
    transform-box: fill-box;
    animation: poolBob 5s ease-in-out infinite;
  }

  .poolBead.b2 { animation-delay: -1.7s; }
  .poolBead.b3 { animation-delay: -3.1s; }

  @keyframes liquidStretch {
    0%, 100% { transform: scaleY(0.82); }
    55% { transform: scaleY(1.12); }
  }

  @keyframes liquidFall {
    0%, 52% { transform: translateY(0) scale(0.6); opacity: 0; }
    58% { opacity: 1; transform: translateY(4px) scale(1); }
    100% { transform: translateY(150px) scale(0.9); opacity: 0; }
  }

  @keyframes poolBob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-7px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .liquidDrip,
    .liquidDrop,
    .poolBead {
      animation: none;
    }
  }

  .heroOrb {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }

  .heroOrbPrimary {
    top: -10%;
    right: -5%;
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(237, 53, 66, 0.12) 0%, transparent 68%);
    filter: blur(45px);
    animation: orbDrift 14s ease-in-out infinite alternate;
  }

  .heroOrbAccent {
    bottom: 5%;
    left: -8%;
    width: 280px;
    height: 280px;
    background: radial-gradient(circle, rgba(180, 170, 150, 0.06) 0%, transparent 65%);
    filter: blur(45px);
    animation: orbDrift 11s ease-in-out infinite alternate-reverse;
  }

  .heroOrbBrand {
    top: 30%;
    left: 50%;
    width: 180px;
    height: 180px;
    margin-left: -90px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.03) 0%, transparent 60%);
    filter: blur(30px);
  }

  @keyframes orbDrift {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(12px, -15px) scale(1.04); }
  }

  .heroGrid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
